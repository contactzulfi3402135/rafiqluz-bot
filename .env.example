# ─────────────────────────────────────────────────────────────
# RAQIFLUZ CHANNEL BOT v6 — environment variables
# On Heroku: Settings → Config Vars (recommended — never commit .env)
# Locally: copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────

# Dashboard login (REQUIRED)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-now

# Session signing key (REQUIRED — any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Cloud memory (STRONGLY recommended) ─────────────────
# Your PRIVATE GitHub repo where the bot saves its own login + data.
# Without it, every Heroku restart/dyno-cycle needs a fresh QR scan.
# Token: GitHub → Settings → Developer settings → Personal access tokens
#        → Fine-grained → ONLY that repo → Contents: Read and write
PERSIST_GITHUB_REPO=your-username/your-private-repo
PERSIST_GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
PERSIST_GITHUB_BRANCH=bot-state

# ── Keep-awake (recommended on eco dynos) ───────────────
# The bot's own https URL — it pings itself every 5 min so the
# dyno never sleeps (pauses 00:00–04:00 PKT by default).
PUBLIC_URL=https://your-app-name.herokuapp.com

# ── Optional ────────────────────────────────────────────
# AI beautifier (free by default — key from openrouter.ai/keys,
# works with a $0 balance)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Daily report time (PKT) and night-pause window (minutes from 00:00 PKT)
REPORT_AT=21:00
NIGHT_START_MIN=0
NIGHT_END_MIN=240

# Post-pull cadence in seconds (default 180 = 3 min)
SOURCE_PULL_SEC=180
