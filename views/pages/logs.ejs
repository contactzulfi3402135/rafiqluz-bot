<%# LOGS — spec §7.16: Activity + Audit tabs, filters, live tail, export %>
<div class="page-head">
  <div>
    <h2><%= t('logs.title') %></h2>
    <div class="sub"><%= t('logs.sub') %></div>
  </div>
</div>

<div class="tabs" id="log-tabs" role="tablist">
  <button class="tab" role="tab" aria-selected="true" data-tab="activity"><%= t('logs.tab.activity') %></button>
  <button class="tab" role="tab" aria-selected="false" data-tab="audit"><%= t('logs.tab.audit') %></button>
</div>

<div class="log-panel" data-panel="activity">
  <div class="card" style="padding:var(--sp-4);margin-bottom:var(--grid-gap)">
    <div style="display:flex;gap:var(--sp-3);align-items:center;flex-wrap:wrap">
      <div style="position:relative;flex:1;min-width:180px">
        <input class="input" id="log-q" placeholder="<%= t('logs.search_ph') %>" style="padding-inline-start:40px">
        <svg class="ic" style="position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--text-3)"><use href="#i-search"/></svg>
      </div>
      <select class="select" id="log-level" style="width:auto" aria-label="<%= t('logs.level') %>">
        <option value="all"><%= t('logs.level.all') %></option>
        <option value="info"><%= t('logs.level.info') %></option>
        <option value="warn"><%= t('logs.level.warn') %></option>
        <option value="error"><%= t('logs.level.error') %></option>
      </select>
      <select class="select" id="log-range" style="width:auto" aria-label="<%= t('logs.range') %>">
        <option value="24h"><%= t('logs.range.24h') %></option>
        <option value="7d"><%= t('logs.range.7d') %></option>
        <option value="30d"><%= t('logs.range.30d') %></option>
      </select>
      <button class="btn btn-secondary" id="log-live" type="button" aria-pressed="false"><span class="dot" style="background:var(--success);width:7px;height:7px;display:inline-block;border-radius:99px;animation:pulse 1.6s infinite"></span><%= t('logs.live') %></button>
      <button class="btn btn-secondary" id="log-export" type="button"><svg class="ic"><use href="#i-download"/></svg><%= t('logs.export') %></button>
    </div>
  </div>
  <div class="card" style="padding:var(--sp-2) var(--sp-4);max-height:560px;overflow-y:auto">
    <div id="log-list">
      <% logs.forEach(function (l) { %>
      <div class="log-line <%= l.level === 'warn' ? 'warn' : l.level === 'error' ? 'error' : '' %>" data-ts="<%= fmt(l.at) %>" data-level="<%= l.level %>" data-msg="<%= l.msg %>">
        <span class="lt"><%= fmt(l.at) %></span>
        <span class="lpill <%= l.level === 'error' ? 'error' : l.level === 'warn' ? 'warn' : 'info' %>"><%= l.level %></span>
        <span class="msg"><%= l.msg %></span>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<div class="log-panel" data-panel="audit" hidden>
  <div class="card" style="padding:var(--sp-4);margin-bottom:var(--grid-gap)">
    <div class="rowline" style="align-items:center">
      <span class="small muted"><%= t('audit.sub') %></span>
      <span class="grow"></span>
      <button class="btn btn-secondary" id="audit-export" type="button"><svg class="ic"><use href="#i-download"/></svg><%= t('logs.export') %></button>
    </div>
  </div>
  <div class="card" style="padding:var(--sp-2) var(--sp-4);max-height:560px;overflow-y:auto">
    <div id="audit-list">
      <% audit.forEach(function (a) { %>
      <div class="log-line" data-ts="<%= fmt(a.at) %>" data-actor="<%= a.actor %>" data-action="<%= a.action %>" data-target="<%= a.target %>">
        <span class="lt"><%= fmt(a.at) %></span>
        <span class="lpill info"><%= a.actor %></span>
        <span class="msg"><%= a.action %><%= a.target ? ' · ' + a.target : '' %></span>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
(function () {
  var tabs = document.querySelectorAll('#log-tabs .tab');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (x) { x.setAttribute('aria-selected', x === tab ? 'true' : 'false'); });
      document.querySelectorAll('.log-panel').forEach(function (p) { p.hidden = p.dataset.panel !== tab.dataset.tab; });
    });
  });
})();
</script>
