<%# SOURCES — spec §6.3 %>
<script>
window.__SOURCES = <%- JSON.stringify(sources) %>;
window.__TGT_LIST = <%- JSON.stringify(targets) %>;
</script>

<div class="page-head">
  <div>
    <h2><%= t('sources.title') %></h2>
    <div class="sub"><%= t('sources.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-primary" id="src-add" type="button"><%= t('sources.add') %></button>
  </div>
</div>

<div class="card" style="padding:0">
  <div class="tabs" id="src-tabs" role="tablist" style="padding:0 20px">
    <button class="tab" role="tab" aria-selected="true" data-filter="all"><%= t('sources.tab.all') %> (<span class="num"><%= counts.all %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="active"><%= t('sources.tab.active') %> (<span class="num"><%= counts.active %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="paused"><%= t('sources.tab.paused') %> (<span class="num"><%= counts.paused %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="error"><%= t('sources.tab.errors') %> (<span class="num"><%= counts.errors %></span>)</button>
  </div>
  <div id="src-list">
    <% sources.forEach(function (s, i) { %>
    <div class="src-row" data-id="<%= s.id %>" data-status="<%= s.status %>" data-name="<%= s.name %>" data-handle="<%= s.handle %>">
      <span class="avatar lg g-<%= i % 6 %>"><%= s.name.charAt(0) %></span>
      <div style="min-width:0">
        <div class="src-name"><%= s.name %></div>
        <div class="src-sub"><%= s.handle %></div>
      </div>
      <span class="src-count"><%= t('sources.subs', { n: s.subs }) %></span>
      <span class="spill <%= s.status === 'active' ? 'spill-success' : s.status === 'paused' ? 'spill-warning' : 'spill-error' %>"><span class="dot"></span><%= t(s.status === 'error' ? 'status.error' : (s.status === 'paused' ? 'common.paused' : 'status.active')) %></span>
      <div class="src-acts">
        <button class="ibtn" data-act="rules" type="button" aria-label="<%= t('common.configure') %>"><svg class="ic"><use href="#i-settings"/></svg></button>
        <button class="ibtn" data-act="menu" type="button" aria-label="menu"><svg class="ic"><use href="#i-more"/></svg></button>
      </div>
    </div>
    <% }) %>
  </div>
</div>
