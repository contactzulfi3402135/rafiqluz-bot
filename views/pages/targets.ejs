<%# TARGETS — spec §7.1 (same pattern as sources + pagination 20/page) %>
<script>
window.__TARGETS = <%- JSON.stringify(targets) %>;
</script>

<div class="page-head">
  <div>
    <h2><%= t('targets.title') %></h2>
    <div class="sub"><%= t('targets.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-primary" id="tg-add" type="button"><%= t('targets.add') %></button>
  </div>
</div>

<div class="card" style="padding:0">
  <div class="tabs" id="tg-tabs" role="tablist" style="padding:0 20px">
    <button class="tab" role="tab" aria-selected="true" data-filter="all"><%= t('targets.tab.all') %> (<span class="num"><%= counts.all %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="active"><%= t('targets.tab.active') %> (<span class="num"><%= counts.active %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="paused"><%= t('targets.tab.paused') %> (<span class="num"><%= counts.paused %></span>)</button>
    <button class="tab" role="tab" aria-selected="false" data-filter="error"><%= t('targets.tab.errors') %> (<span class="num"><%= counts.errors %></span>)</button>
  </div>
  <div id="tg-list">
    <% targets.forEach(function (tg, i) { %>
    <div class="src-row" data-id="<%= tg.id %>" data-status="<%= tg.status %>" data-name="<%= tg.name %>" data-handle="<%= tg.handle %>" style="<%= tg.status === 'error' ? 'background:var(--error-soft)' : '' %>">
      <span class="avatar lg g-<%= (i + 2) % 6 %>"><svg class="ic"><use href="#i-<%= tg.kind === 'user' ? 'users' : tg.kind === 'group' ? 'users' : 'radio' %>"/></svg></span>
      <div style="min-width:0">
        <div class="src-name"><%= tg.name %></div>
        <div class="src-sub"><%= tg.handle %><%= tg.error ? ' · ' + tg.error : '' %></div>
      </div>
      <span class="src-count"><%= t('targets.members', { n: tg.members >= 1000 ? (tg.members / 1000).toFixed(1) + 'K' : tg.members }) %></span>
      <span class="src-count" style="margin-inline-start:0"><%= timeAgo(tg.last) %></span>
      <span class="spill <%= tg.status === 'active' ? 'spill-success' : tg.status === 'paused' ? 'spill-warning' : 'spill-error' %>"><span class="dot"></span><%= t(tg.status === 'error' ? 'status.error' : (tg.status === 'paused' ? 'common.paused' : 'status.active')) %></span>
      <div class="src-acts">
        <% if (tg.status === 'error') { %><button class="btn btn-secondary sm" data-act="fix" type="button"><%= t('targets.reconnect') %></button><% } %>
        <button class="ibtn" data-act="rules" type="button" aria-label="<%= t('common.configure') %>"><svg class="ic"><use href="#i-settings"/></svg></button>
        <button class="ibtn" data-act="menu" type="button" aria-label="menu"><svg class="ic"><use href="#i-more"/></svg></button>
      </div>
    </div>
    <% }) %>
  </div>
  <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-top:1px solid var(--border-1)">
    <span class="small muted num" id="tg-pageinfo"></span>
    <span class="grow"></span>
    <button class="btn btn-secondary sm" id="tg-prev" type="button"><%= t('targets.prev') %></button>
    <button class="btn btn-secondary sm" id="tg-next" type="button"><%= t('targets.next') %></button>
  </div>
</div>
