<%# SCHEDULED — spec §7.6: upcoming list (edit/cancel) + month calendar %>
<script>window.__SCHEDULED = <%- JSON.stringify(scheduled) %>;</script>

<div class="page-head">
  <div>
    <h2><%= t('scheduled.title') %></h2>
    <div class="sub"><%= t('scheduled.sub') %></div>
  </div>
</div>

<div class="sched-layout">
  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-h" style="padding:var(--sp-4) var(--sp-4) 0"><span class="card-t"><%= t('scheduled.upcoming') %></span></div>
    <div id="sch-list" style="padding:var(--sp-2) var(--sp-4) var(--sp-4)">
      <% scheduled.forEach(function (s) { %>
      <div class="sch-row" data-id="<%= s.id %>" data-title="<%= s.title %>" data-at="<%= s.at %>" data-targets="<%= s.targets %>">
        <span class="tile ti-blue" style="width:40px;height:40px;border-radius:10px;display:grid;place-items:center;flex:none"><svg class="ic"><use href="#i-clock"/></svg></span>
        <div style="flex:1;min-width:0">
          <div style="font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= s.title %></div>
          <div class="small muted num" style="direction:ltr"><%= new Date(s.at).toLocaleString([], { weekday: 'short', hour: '2-digit', minute: '2-digit', month: 'short', day: 'numeric' }) %></div>
        </div>
        <span class="htag num"><%= t('scheduled.to_targets', { n: s.targets }) %></span>
        <div class="src-acts" style="flex:none">
          <button class="btn btn-secondary sm" data-act="edit" type="button"><%= t('common.edit') %></button>
          <button class="btn btn-danger sm" data-act="cancel" type="button"><%= t('scheduled.cancel') %></button>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <div class="card" style="padding:var(--sp-5)">
    <div class="rowline" style="margin-bottom:var(--sp-4)">
      <button class="ibtn" id="cal-prev" type="button" aria-label="<%= t('scheduled.prev_month') %>"><svg class="ic"><use href="#i-chevronLeft"/></svg></button>
      <b id="cal-title" style="font-size:15px"></b>
      <button class="ibtn" id="cal-next" type="button" aria-label="<%= t('scheduled.next_month') %>"><svg class="ic"><use href="#i-chevronRight"/></svg></button>
      <span class="grow"></span>
      <span class="small muted num" id="cal-total"></span>
    </div>
    <div class="cal-grid" id="cal-grid"></div>
    <div class="cal-side" id="cal-side" style="margin-top:var(--sp-4);min-height:60px"></div>
  </div>
</div>

<style>
.sched-layout { display: grid; grid-template-columns: 5fr 7fr; gap: var(--grid-gap); align-items: start; }
@media (max-width: 1023.98px) { .sched-layout { grid-template-columns: 1fr; } }
.sch-row { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3); border-bottom: 1px solid var(--border-1); flex-wrap: wrap; }
.sch-row:last-child { border-bottom: 0; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
.cal-grid .dow { font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: .05em; text-align: center; padding: 4px 0; }
.cal-grid .day { position: relative; min-height: 52px; border: 1px solid var(--border-1); border-radius: var(--r-s); padding: 6px 8px; cursor: pointer; font-size: 13px; transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease); }
.cal-grid .day:hover { border-color: var(--border-2); }
.cal-grid .day.other { opacity: .38; }
.cal-grid .day.sel { border-color: var(--accent); background: var(--accent-soft); }
.cal-grid .day .n { font-weight: 600; }
.cal-grid .day .cnt { position: absolute; top: 6px; inset-inline-end: 8px; font-size: 11px; font-weight: 700; color: var(--accent); }
.cal-grid .day .dots { position: absolute; bottom: 6px; inset-inline-start: 8px; display: flex; gap: 3px; }
.cal-grid .day .dots i { width: 5px; height: 5px; border-radius: 99px; background: var(--accent); display: block; }
</style>
