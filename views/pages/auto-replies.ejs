<%# AUTO-REPLIES — spec §7.12: trigger→reply rules + live test %>
<div class="page-head">
  <div>
    <h2><%= t('ar.title') %></h2>
    <div class="sub"><%= t('ar.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-primary" id="ar-new" type="button"><svg class="ic"><use href="#i-plus"/></svg><%= t('ar.new') %></button>
  </div>
</div>

<% if (!on) { %>
<div class="banner banner-warn" style="margin-bottom:var(--grid-gap)">
  <svg class="ic"><use href="#i-alertCircle"/></svg>
  <span><%= t('ar.off') %></span>
  <button class="btn btn-primary sm" id="ar-enable" type="button" style="margin-inline-start:auto"><%= t('ar.enable') %></button>
</div>
<% } %>

<div class="grid">
  <div class="sp7 card" style="padding:0" id="ar-list">
    <div id="ar-rows" style="padding:var(--sp-2) var(--sp-4) var(--sp-4)">
      <% autoReplies.forEach(function (a) { %>
      <div class="rule-row" data-id="<%= a.id %>" data-trigger="<%= a.trigger %>" data-reply="<%= a.reply %>" style="margin-bottom:var(--sp-3);opacity:<%= a.active ? '1' : '.55' %>">
        <span class="tile ti-violet" style="width:40px;height:40px;border-radius:10px;display:grid;place-items:center;flex:none"><svg class="ic"><use href="#i-reply"/></svg></span>
        <div style="flex:1;min-width:0">
          <div class="rowline" style="gap:8px;flex-wrap:wrap">
            <code class="htag mono" style="cursor:default"><%= a.trigger %></code>
            <svg class="ic ic-sm" style="color:var(--text-3)"><use href="#i-arrowRight"/></svg>
            <span class="small" style="color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px"><%= a.reply %></span>
          </div>
          <div class="small muted" style="margin-top:4px"><%= t('ar.match.' + a.match) %> · <%= t('ar.scope.' + a.scope) %></div>
        </div>
        <div class="acts" style="display:flex;gap:var(--sp-2);align-items:center;margin-inline-start:auto">
          <span class="tog" data-act="toggle" role="switch" tabindex="0" aria-checked="<%= a.active ? 'true' : 'false' %>" aria-label="<%= t('ar.on') %>"></span>
          <button class="ibtn" data-act="edit" type="button" aria-label="<%= t('common.edit') %>"><svg class="ic"><use href="#i-pen"/></svg></button>
          <button class="ibtn" data-act="del" type="button" aria-label="<%= t('common.delete') %>"><svg class="ic"><use href="#i-trash"/></svg></button>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <div class="sp5 card" style="padding:var(--sp-5)">
    <div class="card-h"><span class="card-t"><%= t('ar.test_title') %></span></div>
    <div class="small muted" style="margin-bottom:var(--sp-3)"><%= t('ar.test_sub') %></div>
    <div class="field">
      <label for="ar-test"><%= t('ar.test_label') %></label>
      <input class="input" id="ar-test" placeholder="<%= t('ar.test_ph') %>" maxlength="120">
    </div>
    <button class="btn btn-secondary" id="ar-test-btn" type="button"><%= t('ar.test_run') %></button>
    <div id="ar-test-out" class="small" style="display:none;margin-top:var(--sp-3);padding:var(--sp-3);border:1px solid var(--border-1);border-radius:var(--r-m);background:var(--surface-2)"></div>
  </div>
</div>
