<%# COMPOSE — spec §7.5: editor + live preview (footer/hashtags/dedupe/strip-links) %>
<script>
window.__BRAND = <%- JSON.stringify(brand) %>;
window.__PREFILL = <%- JSON.stringify(prefill) %>;
</script>

<div class="page-head">
  <div>
    <h2><%= t('compose.title') %></h2>
    <div class="sub"><%= t('compose.sub') %></div>
  </div>
</div>

<div class="compose-grid">
  <div>
    <div class="card" style="padding:var(--sp-5)">
      <div class="field">
        <label for="cmp-title"><%= t('compose.title') %></label>
        <input class="input" id="cmp-title" placeholder="<%= t('compose.title_ph') %>" maxlength="80">
      </div>
      <div class="c-toolbar" role="toolbar" aria-label="<%= t('compose.toolbar') %>">
        <button class="ibtn" data-a="bold" type="button" title="B" aria-label="<%= t('compose.toolbar') %>"><b>B</b></button>
        <button class="ibtn" data-a="italic" type="button" aria-label="<%= t('compose.toolbar') %>" style="font-style:italic">I</button>
        <button class="ibtn" data-a="link" type="button" aria-label="<%= t('compose.toolbar') %>"><svg class="ic ic-sm"><use href="#i-link"/></svg></button>
        <button class="ibtn" data-a="hash" type="button" aria-label="<%= t('compose.toolbar') %>" style="font-family:var(--font-mono)">#</button>
        <button class="ibtn" data-a="emoji" type="button" aria-label="<%= t('compose.toolbar') %>" style="font-size:15px">🙂</button>
      </div>
      <textarea class="textarea" id="cmp-text" rows="9" placeholder="<%= t('compose.text_ph') %>" style="resize:vertical"><%= prefill %></textarea>
      <div class="c-count num" id="cmp-count"><%= t('compose.chars', { n: prefill.length }) %></div>
      <div class="rowline" style="gap:var(--sp-3);margin-top:var(--sp-3);flex-wrap:wrap">
        <div class="dropzone" id="cmp-drop" style="flex:1;min-width:180px;padding:var(--sp-3)">
          <svg class="ic"><use href="#i-image"/></svg>
          <span><%= t('compose.media') %></span>
        </div>
        <input type="file" id="cmp-file" hidden>
        <button class="btn btn-secondary" id="cmp-ai" type="button" style="height:44px"><svg class="ic"><use href="#i-sparkles"/></svg><%= t('compose.ai') %></button>
      </div>
    </div>

    <div class="card" style="padding:var(--sp-5);margin-top:var(--grid-gap)">
      <div class="card-h"><span class="card-t"><%= t('compose.targets') %></span></div>
      <div class="rowline" style="gap:var(--sp-2);margin-bottom:var(--sp-3)">
        <button class="btn btn-secondary sm" id="cmp-tgs-all" type="button"><%= t('compose.all_targets') %></button>
        <span class="small muted" id="cmp-tgs-cnt"></span>
      </div>
      <div class="tchip-wrap" id="cmp-tgs" style="max-height:150px">
        <% targets.slice(0, 24).forEach(function (tg, i) { %>
        <span class="tchip<%= i < 4 ? ' on' : '' %>" data-name="<%= tg.name %>" role="checkbox" tabindex="0" aria-checked="<%= i < 4 ? 'true' : 'false' %>"><span class="box"><svg class="ic"><use href="#i-check"/></svg></span><%= tg.name %></span>
        <% }) %>
      </div>
    </div>

    <div class="card" style="padding:var(--sp-5);margin-top:var(--grid-gap)">
      <div class="card-h"><span class="card-t"><%= t('compose.delivery') %></span></div>
      <div class="dl-cards">
        <button class="dl-card" data-dl="queue" role="radio" aria-checked="true" type="button"><span class="rad"></span><span><%= t('compose.dl.queue') %></span></button>
        <button class="dl-card" data-dl="now" role="radio" aria-checked="false" type="button"><span class="rad"></span><span><%= t('compose.dl.now') %></span></button>
        <button class="dl-card" data-dl="schedule" role="radio" aria-checked="false" type="button"><span class="rad"></span><span><%= t('compose.dl.schedule') %></span></button>
      </div>
      <div id="cmp-sched" class="hidden" style="margin-top:var(--sp-3)">
        <div class="field">
          <label for="cmp-when"><%= t('compose.schedule_at') %></label>
          <input class="input" type="datetime-local" id="cmp-when">
        </div>
      </div>
      <div class="rowline" style="gap:var(--sp-3);margin-top:var(--sp-4)">
        <button class="btn btn-secondary" id="cmp-draft" type="button"><%= t('compose.draft') %></button>
        <span class="grow"></span>
        <button class="btn btn-primary" id="cmp-send" type="button" style="min-width:160px"><%= t('compose.send_queue') %></button>
      </div>
    </div>
  </div>

  <div class="card" style="padding:var(--sp-5);position:sticky;top:84px">
    <div class="card-h"><span class="card-t"><%= t('compose.preview') %></span><span class="pill-status" style="height:20px;font-size:11px;padding:0 8px"><%= t('common.live') %></span></div>
    <div class="bubble" id="cmp-preview" style="margin-top:var(--sp-3)"></div>
    <div class="small muted" style="margin-top:var(--sp-3)"><%= t('compose.preview_note') %></div>
  </div>
</div>
