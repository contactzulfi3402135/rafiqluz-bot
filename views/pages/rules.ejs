<%# RULES — spec §7.14: content rules, drag reorder, priority %>
<div class="page-head">
  <div>
    <h2><%= t('rules.title') %></h2>
    <div class="sub"><%= t('rules.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-primary" id="rule-new" type="button"><svg class="ic"><use href="#i-plus"/></svg><%= t('rules.new') %></button>
  </div>
</div>

<div id="rule-list">
  <% rules.forEach(function (r) { %>
  <div class="rule-row" data-id="<%= r.id %>" data-name="<%= r.name %>" style="opacity:<%= r.on ? '1' : '.55' %>">
    <span class="grip" title="<%= t('rules.drag') %>" style="cursor:grab;color:var(--text-3);display:grid;place-items:center"><svg class="ic"><use href="#i-grip"/></svg></span>
    <span class="rule-prio num" style="font-weight:700;color:var(--text-3);min-width:20px;text-align:center"><%= r.priority %></span>
    <div style="flex:1;min-width:0">
      <div class="rowline" style="gap:8px;flex-wrap:wrap">
        <b style="font-size:14.5px"><%= r.name %></b>
        <span class="htag mono" style="cursor:default"><%= r.cond.value %></span>
        <svg class="ic ic-sm" style="color:var(--text-3)"><use href="#i-arrowRight"/></svg>
        <span class="htag" style="cursor:default"><%= t('rules.act.' + r.act.type) %><%= r.act.value ? ' · ' + r.act.value : '' %></span>
      </div>
    </div>
    <div class="acts" style="display:flex;gap:var(--sp-2);align-items:center;margin-inline-start:auto">
      <span class="tog" data-act="toggle" role="switch" tabindex="0" aria-checked="<%= r.on ? 'true' : 'false' %>" aria-label="<%= t('rules.on') %>"></span>
      <button class="ibtn" data-act="del" type="button" aria-label="<%= t('common.delete') %>"><svg class="ic"><use href="#i-trash"/></svg></button>
    </div>
  </div>
  <% }) %>
</div>
