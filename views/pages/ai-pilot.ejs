<%# AI PILOT — spec §7.13: mode segmented, suggestions accept/dismiss, event feed %>
<div class="page-head">
  <div>
    <h2><%= t('pilot.title') %></h2>
    <div class="sub"><%= t('pilot.sub') %></div>
  </div>
</div>

<% if (!on) { %>
<div class="banner banner-warn" style="margin-bottom:var(--grid-gap)">
  <svg class="ic"><use href="#i-bot"/></svg>
  <span><%= t('pilot.off') %></span>
  <button class="btn btn-primary sm" id="pilot-enable" type="button" style="margin-inline-start:auto"><%= t('pilot.enable') %></button>
</div>
<% } %>

<div class="grid">
  <div class="sp7">
    <div class="card" style="padding:var(--sp-5)">
      <div class="card-h"><span class="card-t"><%= t('pilot.mode') %></span></div>
      <div class="seg" id="pilot-mode" role="radiogroup" aria-label="<%= t('pilot.mode') %>">
        <% ['suggest', 'auto', 'off'].forEach(function (m) { %>
        <button type="button" data-mode="<%= m %>" aria-pressed="<%= mode === m ? 'true' : 'false' %>"><%= t('pilot.mode.' + m) %></button>
        <% }) %>
      </div>
      <div class="small muted" style="margin-top:var(--sp-2)"><%= t('pilot.mode_sub') %></div>
    </div>

    <div class="card" style="padding:var(--sp-5);margin-top:var(--grid-gap)">
      <div class="card-h"><span class="card-t"><%= t('pilot.suggestions') %></span><span class="htag num" style="cursor:default"><%= suggestions.length %></span></div>
      <div id="pilot-feed" style="display:flex;flex-direction:column;gap:var(--sp-3)">
        <% suggestions.forEach(function (s) { %>
        <div class="pilot-card" data-id="<%= s.id %>" style="border:1px solid var(--border-1);border-radius:var(--r-m);padding:var(--sp-4);background:var(--surface-2)">
          <div class="rowline" style="gap:12px;align-items:flex-start">
            <span class="tile ti-violet" style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;flex:none"><svg class="ic"><use href="#i-<%= { route: 'route', clock: 'clock', hash: 'hash', scissors: 'scissors' }[s.icon] || 'sparkles' %>"/></svg></span>
            <div style="flex:1;min-width:0">
              <div style="font-size:14px;font-weight:600"><%= s.title %></div>
              <div class="small muted" style="margin-top:2px"><%= s.reason %></div>
            </div>
            <div style="display:flex;gap:var(--sp-2);flex:none">
              <button class="btn btn-primary sm" data-act="accept" type="button"><%= t('pilot.accept') %></button>
              <button class="btn btn-secondary sm" data-act="dismiss" type="button"><%= t('pilot.dismiss') %></button>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="sp5 card" style="padding:var(--sp-5)">
    <div class="card-h"><span class="card-t"><%= t('pilot.events') %></span></div>
    <div style="display:flex;flex-direction:column">
      <% events.forEach(function (e) { %>
      <div class="rowline" style="gap:12px;padding:var(--sp-3) 0;border-bottom:1px solid var(--border-1);align-items:flex-start">
        <span class="act-dot ok" style="margin-top:5px"></span>
        <div style="flex:1;min-width:0">
          <div style="font-size:13.5px"><%= e.msg %></div>
          <div class="small muted num" style="direction:ltr"><%= timeAgo(e.at) %></div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
