<%# ROUTING — spec §7.3: ordered route cards, drag reorder, toggles %>
<script>
window.__SRC_LIST = <%- JSON.stringify(sources) %>;
window.__TGT_LIST = <%- JSON.stringify(targets.map(tg => tg.name)) %>;
</script>

<div class="page-head">
  <div>
    <h2><%= t('routing.title') %></h2>
    <div class="sub"><%= t('routing.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-primary" id="route-new" type="button"><svg class="ic"><use href="#i-plus"/></svg><%= t('routing.new') %></button>
  </div>
</div>

<div id="route-list">
  <% routes.forEach(function (rt) { %>
  <div class="route-card" data-id="<%= rt.id %>" data-source="<%= rt.source %>" data-targets="<%- JSON.stringify(rt.targets) %>">
    <div class="rowline" style="gap:16px">
      <span class="grip" title="<%= t('routing.drag') %>" style="cursor:grab;color:var(--text-3);display:grid;place-items:center"><svg class="ic"><use href="#i-grip"/></svg></span>
      <span class="route-prio num"><%= routes.indexOf(rt) + 1 %></span>
      <div class="route-line">
        <b><%= rt.source %></b>
        <span class="route-arrow"><svg class="ic ic-sm"><use href="#i-arrowRight"/></svg></span>
        <span class="route-tgs">
          <% rt.targets.forEach(function (tg) { %><span class="htag"><%= tg %></span><% }) %>
        </span>
      </div>
      <div class="route-cond">
        <% if (rt.when.keywords) { %><span class="htag" title="<%= t('routing.cond.keywords') %>"><%= t('routing.cond.keywords_short') %>: <%= rt.when.keywords %></span><% } %>
        <% if (rt.when.media) { %><span class="htag"><%= t('routing.cond.media') %></span><% } %>
        <% if (rt.when.lang !== 'any') { %><span class="htag"><%= t('routing.cond.lang') %>: <%= rt.when.lang.toUpperCase() %></span><% } %>
        <% if (rt.delay) { %><span class="htag num" title="<%= t('routing.cond.delay') %>"><%= t('routing.cond.delay_short') %> <%= rt.delay %></span><% } %>
        <span class="htag" title="<%= t('routing.cond.approval') %>"><%= t('routing.cond.approval_short') %>: <%= t('routing.cond.' + rt.approval) %></span>
      </div>
      <div class="route-acts">
        <span class="tog" data-act="toggle" role="switch" tabindex="0" aria-checked="<%= rt.on ? 'true' : 'false' %>" aria-label="<%= t('routing.enable') %>"></span>
        <button class="ibtn" data-act="del" type="button" aria-label="<%= t('common.delete') %>"><svg class="ic"><use href="#i-trash"/></svg></button>
      </div>
    </div>
  </div>
  <% }) %>
</div>
