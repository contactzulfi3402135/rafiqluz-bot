<%# CONTACTS — spec §7.11: 8 contacts, role filter, test send %>
<div class="page-head">
  <div>
    <h2><%= t('contacts.title') %></h2>
    <div class="sub"><%= t('contacts.sub') %></div>
  </div>
  <div class="acts">
    <button class="btn btn-secondary" id="ct-import" type="button"><svg class="ic"><use href="#i-upload"/></svg><%= t('contacts.import') %></button>
    <button class="btn btn-primary" id="ct-add" type="button"><svg class="ic"><use href="#i-plus"/></svg><%= t('contacts.add') %></button>
  </div>
</div>

<div class="card" style="padding:var(--sp-4);margin-bottom:var(--grid-gap)">
  <div class="hist-filters" style="display:flex;gap:var(--sp-3);align-items:center;flex-wrap:wrap">
    <div style="position:relative;flex:1;min-width:200px">
      <input class="input" id="ct-q" placeholder="<%= t('contacts.search_ph') %>" style="padding-inline-start:40px">
      <svg class="ic" style="position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--text-3)"><use href="#i-search"/></svg>
    </div>
    <select class="select" id="ct-role" style="width:auto" aria-label="<%= t('contacts.role') %>">
      <option value="all"><%= t('contacts.all_roles') %></option>
      <option value="owner"><%= t('contacts.role.owner') %></option>
      <option value="admin"><%= t('contacts.role.admin') %></option>
      <option value="viewer"><%= t('contacts.role.viewer') %></option>
    </select>
  </div>
</div>

<div class="card" style="padding:0">
  <div id="ct-rows">
    <% contacts.forEach(function (c, i) { %>
    <div class="src-row" data-id="<%= c.id %>" data-name="<%= c.name %>" data-phone="<%= c.phone %>" data-role="<%= c.role %>" style="min-height:64px">
      <span class="avatar lg g-<%= i % 6 %>"><svg class="ic"><use href="#i-user"/></svg></span>
      <div style="min-width:0">
        <div class="src-name" style="font-size:15px"><%= c.name %></div>
        <div class="src-sub" style="font-family:var(--font-mono)"><%= c.phone %></div>
      </div>
      <span class="htag"><%= c.tag %></span>
      <span class="htag" style="cursor:default"><%= t('contacts.role.' + c.role) %></span>
      <span class="src-count small muted"><%= timeAgo(c.last) %></span>
      <div class="src-acts" style="margin-inline-start:auto">
        <button class="btn btn-secondary sm" data-act="test" type="button"><svg class="ic"><use href="#i-send"/></svg><%= t('contacts.test') %></button>
        <button class="ibtn" data-act="menu" type="button" aria-label="menu"><svg class="ic"><use href="#i-more"/></svg></button>
      </div>
    </div>
    <% }) %>
  </div>
</div>
