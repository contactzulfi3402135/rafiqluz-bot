<%# Mobile (spec §3.4): bottom tab bar + hamburger drawer %>

<nav class="tabbar" aria-label="Primary">
  <a href="/" data-nav="home" <%= navKey==='home' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-home"/></svg><span><%= t('nav.home') %></span></a>
  <a href="/queue" data-nav="queue" <%= navKey==='queue' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-inbox"/></svg><span><%= t('nav.queue') %></span><% if (queueCount > 0) { %><span class="nav-badge" id="qbadge-m"><%= queueCount %></span><% } %></a>
  <a href="/analytics" data-nav="analytics" <%= navKey==='analytics' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-chart"/></svg><span><%= t('nav.analytics') %></span></a>
  <a href="/settings" data-nav="settings" <%= navKey==='settings' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-settings"/></svg><span><%= t('nav.settings') %></span></a>
</nav>

<div class="m-drawer" id="m-drawer" role="dialog" aria-modal="true" aria-label="<%= t('nav.home') %>">
  <div class="scrim" data-close-m></div>
  <div class="brand">
    <span class="brand-mark" aria-hidden="true"><svg class="ic" style="width:20px;height:20px"><use href="#i-leaf"/></svg></span>
    <span class="brand-name"><%= t('app.name') %></span>
    <button class="ibtn" style="margin-inline-start:auto" data-close-m type="button" aria-label="<%= t('common.close') %>"><svg class="ic"><use href="#i-x"/></svg></button>
  </div>
  <nav class="nav" id="nav-mobile" style="overflow-y:auto">
    <a class="nav-item" href="/" data-nav="home" <%= navKey==='home' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-home"/></svg><span><%= t('nav.home') %></span></a>
    <a class="nav-item" href="/sources" data-nav="sources" <%= navKey==='sources' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-radio"/></svg><span><%= t('nav.sources') %></span></a>
    <a class="nav-item" href="/targets" data-nav="targets" <%= navKey==='targets' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-target"/></svg><span><%= t('nav.targets') %></span></a>
    <a class="nav-item" href="/discover" data-nav="discover" <%= navKey==='discover' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-compass"/></svg><span><%= t('nav.discover') %></span></a>
    <a class="nav-item" href="/routing" data-nav="routing" <%= navKey==='routing' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-route"/></svg><span><%= t('nav.routing') %></span></a>
    <a class="nav-item" href="/compose" data-nav="compose" <%= navKey==='compose' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-pen"/></svg><span><%= t('nav.compose') %></span></a>
    <a class="nav-item" href="/queue" data-nav="queue" <%= navKey==='queue' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-inbox"/></svg><span><%= t('nav.queue') %></span><% if (queueCount > 0) { %><span class="nav-badge" id="qbadge-d"><%= queueCount %></span><% } %></a>
    <a class="nav-item" href="/scheduled" data-nav="scheduled" <%= navKey==='scheduled' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-calendar"/></svg><span><%= t('nav.scheduled') %></span></a>
    <a class="nav-item" href="/history" data-nav="history" <%= navKey==='history' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-history"/></svg><span><%= t('nav.history') %></span></a>
    <a class="nav-item" href="/library" data-nav="library" <%= navKey==='library' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-image"/></svg><span><%= t('nav.library') %></span></a>
    <a class="nav-item" href="/brand" data-nav="brand" <%= navKey==='brand' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-layers"/></svg><span><%= t('nav.brand') %></span></a>
    <div class="nav-divider" role="presentation"></div>
    <a class="nav-item" href="/whatsapp" data-nav="whatsapp" <%= navKey==='whatsapp' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-message"/></svg><span><%= t('nav.whatsapp') %></span></a>
    <a class="nav-item" href="/contacts" data-nav="contacts" <%= navKey==='contacts' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-users"/></svg><span><%= t('nav.contacts') %></span></a>
    <a class="nav-item" href="/auto-replies" data-nav="autoreplies" <%= navKey==='autoreplies' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-reply"/></svg><span><%= t('nav.autoreplies') %></span></a>
    <a class="nav-item" href="/ai-pilot" data-nav="pilot" <%= navKey==='pilot' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-bot"/></svg><span><%= t('nav.pilot') %></span></a>
    <a class="nav-item" href="/rules" data-nav="rules" <%= navKey==='rules' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-shield"/></svg><span><%= t('nav.rules') %></span></a>
    <div class="nav-divider" role="presentation"></div>
    <a class="nav-item" href="/analytics" data-nav="analytics" <%= navKey==='analytics' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-chart"/></svg><span><%= t('nav.analytics') %></span></a>
    <a class="nav-item" href="/health" data-nav="health" <%= navKey==='health' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-activity"/></svg><span><%= t('nav.health') %></span></a>
    <a class="nav-item" href="/logs" data-nav="logs" <%= navKey==='logs' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-terminal"/></svg><span><%= t('nav.logs') %></span></a>
    <a class="nav-item" href="/settings" data-nav="settings" <%= navKey==='settings' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-settings"/></svg><span><%= t('nav.settings') %></span></a>
    <a class="nav-item" href="/about" data-nav="about" <%= navKey==='about' ? 'aria-current="page"' : '' %>><svg class="ic"><use href="#i-info"/></svg><span><%= t('nav.about') %></span></a>
  </nav>
  <div class="side-foot">
    <span class="pill-status <%= paused ? 'paused' : '' %>" id="side-status-m">
      <span class="dot"></span><span id="side-status-txt-m"><%= paused ? t('app.paused') : t('app.online') %></span>
    </span>
    <button class="btn <%= paused ? 'btn-primary' : 'btn-danger-solid' %> panic-btn" id="panic-btn-m" type="button" style="width:100%;min-height:44px">
      <% if (!paused) { %><svg class="ic"><use href="#i-pause"/></svg><span class="plabel"><%= t('panic.label') %></span><svg class="ic"><use href="#i-pause"/></svg>
      <% } else { %><svg class="ic"><use href="#i-play"/></svg><span class="plabel"><%= t('panic.resume') %></span><svg class="ic"><use href="#i-play"/></svg>
      <% } %>
    </button>
  </div>
</div>
