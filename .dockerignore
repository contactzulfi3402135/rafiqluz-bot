# Send only files the Dockerfile needs; never send state, archives or local config.
**
!Dockerfile
!package.json
!package-lock.json
!src/
!src/**
!scripts/
!scripts/**
# Exclude sensitive or generated material even if nested in allowed trees.
**/.env
**/.env.*
**/node_modules
**/.git
**/data
**/sessions
**/media
**/uploads
**/backups
**/logs
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.zip
**/*.tar
**/*.tar.gz
