# Copy to .env and replace both values with strong secrets; never commit .env.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-this-with-a-unique-strong-password
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
PUBLIC_PAIRING=0
# Optional; these send state to a private GitHub repository when enabled.
PERSIST_GITHUB_REPO=
PERSIST_GITHUB_TOKEN=
PERSIST_GITHUB_BRANCH=bot-state
PUBLIC_URL=
