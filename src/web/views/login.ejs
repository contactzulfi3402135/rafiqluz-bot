<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0B0F14">
<title>Sign in · <%= botName %></title>
<link rel="icon" href="/pwa/icon-192.png">
<style>
/* ═══ Raqifluz — v12 Obsidian · sign-in ═══ self-contained, zero dependencies ═══ */
@font-face { font-family: 'Inter'; src: url('/fonts/inter-latin.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
:root {
  --bg: #05090f; --panel: #0d141d; --panel-2: #111a25; --line: #1e2c3a; --line-2: #2c3f52;
  --text: #f2f7fb; --text-2: #a9bccd; --text-3: #6b8093;
  --ok: #10b981; --ok-hot: #34d399; --ok-deep: #059669; --gold: #f5b54a;
  --grad: linear-gradient(135deg, #6ee7b7 0%, #10b981 45%, #059669 100%);
  --ease: cubic-bezier(.16, 1, .3, 1);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg); color: var(--text); min-height: 100vh; min-height: 100dvh;
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
::selection { background: rgba(16,185,129,.35); }
:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(16,185,129,.35), 0 0 0 1.5px #10b981; border-radius: 12px; }

.shell { min-height: 100vh; min-height: 100dvh; display: grid; grid-template-columns: 1.15fr 1fr; }

/* ── Brand panel — living artwork ───────────────────────────────────────── */
.brand {
  position: relative; overflow: hidden; display: flex; flex-direction: column;
  justify-content: space-between; padding: 42px 48px; isolation: isolate;
  border-right: 1px solid rgba(110,231,183,.14);
}
.brand-art {
  position: absolute; inset: -6%; z-index: -1; background: url('/brand/aurora.jpg') center 30% / cover no-repeat;
  animation: artDrift 26s ease-in-out infinite alternate; will-change: transform;
}
@keyframes artDrift { from { transform: scale(1) translate3d(0,0,0); } to { transform: scale(1.12) translate3d(-2.5%, -4%, 0); } }
.brand::after {
  content: ""; position: absolute; inset: 0; z-index: -1;
  background:
    linear-gradient(180deg, rgba(5,9,15,.62) 0%, rgba(5,9,15,.18) 34%, rgba(5,9,15,.30) 62%, rgba(5,9,15,.88) 100%),
    linear-gradient(105deg, rgba(5,9,15,.72) 0%, rgba(5,9,15,.08) 55%, transparent 80%);
}
.brand-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.lockup { display: flex; align-items: center; gap: 14px; }
.mark {
  width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;
  background: var(--grad); box-shadow: 0 0 28px rgba(16,185,129,.55), inset 0 1px 0 rgba(255,255,255,.5);
  font-weight: 900; font-size: 23px; color: #04130d; letter-spacing: -0.05em;
  transition: transform .35s cubic-bezier(.34,1.56,.64,1);
}
.lockup:hover .mark { transform: rotate(-6deg) scale(1.07); }
.lockup-name { font-size: 15px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
.lockup-sub { font-size: 10px; letter-spacing: .3em; color: var(--ok-hot); text-transform: uppercase; font-weight: 700; opacity: .9; }
.build-tag {
  font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: #c8f7df;
  border: 1px solid rgba(110,231,183,.4); background: rgba(16,185,129,.12); backdrop-filter: blur(6px);
  padding: 7px 13px; border-radius: 999px; white-space: nowrap; font-weight: 700;
}
.brand-mid { max-width: 560px; }
.eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--ok-hot); font-weight: 800; margin-bottom: 18px; }
.eyebrow::before { content: ""; width: 26px; height: 1px; background: linear-gradient(90deg, transparent, var(--ok-hot)); }
.headline { font-size: clamp(34px, 3.6vw, 54px); line-height: 1.03; font-weight: 800; letter-spacing: -0.035em; }
.headline em { font-style: normal; background: linear-gradient(120deg, #a7f3d0 0%, #34d399 35%, #10b981 60%, #f5b54a 130%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.lede { margin-top: 18px; color: #c3d4e2; font-size: 14.5px; line-height: 1.65; max-width: 46ch; }
.feat { margin-top: 26px; display: grid; gap: 12px; }
.feat-row { display: flex; gap: 12px; align-items: flex-start; }
.feat-ico { flex: none; width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: rgba(16,185,129,.14); border: 1px solid rgba(110,231,183,.35); color: var(--ok-hot); }
.feat-row p { font-size: 12.5px; color: #b8cbda; line-height: 1.5; }
.feat-row b { color: #eef6fc; font-weight: 650; }
.brand-foot { display: flex; align-items: center; gap: 10px; color: #7d93a6; font-size: 11px; letter-spacing: .04em; flex-wrap: wrap; }
.brand-foot .dot { width: 4px; height: 4px; border-radius: 50%; background: #33475a; }
.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 10px 2px rgba(16,185,129,.7); animation: pdot 1.7s ease-in-out infinite; display: inline-block; }
@keyframes pdot { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

/* ── Auth panel ─────────────────────────────────────────────────────────── */
.auth {
  display: grid; place-items: center; padding: 40px 28px; position: relative;
  background:
    radial-gradient(70rem 40rem at 120% -10%, rgba(16,185,129,.10), transparent 55%),
    radial-gradient(50rem 40rem at -30% 110%, rgba(59,130,246,.08), transparent 55%),
    var(--panel);
}
.auth-card { width: min(420px, 100%); animation: cardIn .7s var(--ease) both; }
@keyframes cardIn { from { opacity: 0; transform: translateY(22px) scale(.97); } to { opacity: 1; transform: none; } }
.auth-kicker { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--text-3); font-weight: 800; margin-bottom: 10px; }
h1 { font-size: 28px; letter-spacing: -0.025em; font-weight: 800; }
.sub { color: var(--text-2); font-size: 13px; margin-top: 7px; line-height: 1.55; }
.login-error {
  display: flex; gap: 10px; align-items: center; background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.4);
  color: #fecaca; border-radius: 12px; padding: 11px 14px; font-size: 13px; margin: 16px 0 0; animation: shake .4s var(--ease);
}
@keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-7px); } 75% { transform: translateX(7px); } }
form { margin-top: 24px; display: grid; gap: 16px; }
label { display: grid; gap: 7px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 800; color: var(--text-3); }
.field { position: relative; }
.field input {
  width: 100%; height: 50px; padding: 0 46px 0 16px; font-size: 15px; color: var(--text);
  background: var(--panel-2); border: 1px solid var(--line); border-radius: 13px; transition: border-color .18s, box-shadow .22s;
  font-family: inherit; letter-spacing: .02em;
}
.field input::placeholder { color: #46586b; }
.field input:hover { border-color: var(--line-2); }
.field input:focus { outline: none; border-color: var(--ok); box-shadow: 0 0 0 3px rgba(16,185,129,.25), 0 0 22px rgba(16,185,129,.18); }
.field-ico { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #4c6076; pointer-events: none; }
.toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border: 0; background: transparent; color: #6b8093; border-radius: 9px; cursor: pointer; display: grid; place-items: center; transition: color .15s, background .15s; }
.toggle-pw:hover { color: var(--ok-hot); background: rgba(16,185,129,.08); }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: -4px; }
.remember { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-3); letter-spacing: .06em; text-transform: none; font-weight: 600; cursor: pointer; user-select: none; }
.remember input { accent-color: var(--ok); width: 15px; height: 15px; cursor: pointer; }
.escape-link { font-size: 11.5px; color: var(--ok-hot); text-decoration: none; font-weight: 650; }
.escape-link:hover { text-decoration: underline; }
.btn {
  height: 52px; border: 0; border-radius: 14px; font-size: 15px; font-weight: 800; cursor: pointer; letter-spacing: .02em;
  background: var(--grad); color: #04130d; font-family: inherit;
  box-shadow: 0 10px 30px -8px rgba(16,185,129,.55), inset 0 1px 0 rgba(255,255,255,.55);
  position: relative; overflow: hidden; transition: transform .18s var(--ease), filter .18s, box-shadow .25s;
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
}
.btn::before { content: ""; position: absolute; top: -60%; bottom: -60%; width: 50px; left: -90px; background: linear-gradient(105deg, transparent, rgba(255,255,255,.8), transparent); transform: skewX(-22deg); transition: left .85s var(--ease); }
.btn:hover { filter: brightness(1.07); transform: translateY(-1px); box-shadow: 0 14px 36px -8px rgba(16,185,129,.6), inset 0 1px 0 rgba(255,255,255,.6); }
.btn:hover::before { left: calc(100% + 90px); }
.btn:active { transform: translateY(0) scale(.985); }
.btn[disabled] { opacity: .6; cursor: wait; }
.btn .spinner { width: 17px; height: 17px; border-radius: 50%; border: 2px solid rgba(4,19,13,.3); border-top-color: #04130d; animation: rot .7s linear infinite; display: none; }
@keyframes rot { to { transform: rotate(360deg); } }
.btn.loading .spinner { display: inline-block; }
.btn.loading .btn-label { opacity: .75; }
.security-strip { margin-top: 22px; display: flex; gap: 8px; flex-wrap: wrap; }
.sec-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: #8fd6b4; border: 1px solid rgba(110,231,183,.3); background: rgba(16,185,129,.08); padding: 5px 10px; border-radius: 6px; font-weight: 700; }
.divider { display: flex; align-items: center; gap: 12px; margin: 24px 0 14px; color: #3d4f63; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; font-weight: 800; }
.divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.connect-alt { display: flex; align-items: center; gap: 12px; border: 1px dashed var(--line-2); border-radius: 14px; padding: 13px 15px; text-decoration: none; transition: border-color .2s, background .2s; }
.connect-alt:hover { border-color: var(--ok); background: rgba(16,185,129,.06); }
.connect-alt b { color: var(--text); font-size: 13px; display: block; }
.connect-alt span { color: var(--text-3); font-size: 11px; }
.connect-alt svg { margin-left: auto; color: var(--ok-hot); flex: none; }
.foot-note { margin-top: 26px; text-align: center; color: #54687c; font-size: 10.5px; letter-spacing: .08em; }

/* ── Responsive ─────────────────────────────────────────────────────────── */
@media (max-width: 1024px) { .brand { padding: 32px 34px; } .headline { font-size: clamp(30px, 4.6vw, 40px); } .feat { display: none; } }
@media (max-width: 860px) {
  .shell { grid-template-columns: 1fr; }
  .brand { min-height: 300px; border-right: 0; border-bottom: 1px solid rgba(110,231,183,.14); padding: 24px; }
  .headline { font-size: 30px; } .lede { font-size: 13px; margin-top: 10px; }
  .brand-foot, .build-tag, .eyebrow { display: none; }
  .auth { padding: 28px 18px 44px; }
}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>
</head>
<body>
<main class="shell">

  <!-- ══ Brand / art panel ══ -->
  <section class="brand" aria-hidden="true">
    <div class="brand-art"></div>

    <div class="brand-top">
      <div class="lockup">
        <div class="mark">R</div>
        <div>
          <div class="lockup-name">Raqifluz</div>
          <div class="lockup-sub">Signal Desk</div>
        </div>
      </div>
      <span class="build-tag">v12.0 · Obsidian</span>
    </div>

    <div class="brand-mid">
      <div class="eyebrow">WhatsApp Channel Engine</div>
      <h2 class="headline">One number.<br>Every channel.<br><em>Zero noise.</em></h2>
      <p class="lede">Follow once — Raqifluz mirrors, cleans, schedules and ships every post to your channels on autopilot, with a human approval loop when you want the final word.</p>
      <div class="feat">
        <div class="feat-row">
          <span class="feat-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
          <p><b>Hands-off mirroring.</b> Sources → targets with dedupe, rate guards and adaptive pacing built in.</p>
        </div>
        <div class="feat-row">
          <span class="feat-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 3 4 8v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V8l-8-5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
          <p><b>Guardrails first.</b> Approval queue, panic stop, freshness &amp; blocked-word shields — nothing ships unchecked.</p>
        </div>
        <div class="feat-row">
          <span class="feat-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 19V9m6 10V5m6 14v-7m4 7H2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
          <p><b>Real analytics.</b> Delivery journals, skip reasons, latency KPIs and weekly reports — exportable anytime.</p>
        </div>
      </div>
    </div>

    <div class="brand-foot">
      <span class="pulse-dot"></span> Live <span class="dot"></span> Self-hosted on your infrastructure <span class="dot"></span> MIT licensed <span class="dot"></span> Single authorized operator
    </div>
  </section>

  <!-- ══ Auth panel ══ -->
  <section class="auth">
    <div class="auth-card">
      <div class="auth-kicker">Secure workspace</div>
      <h1>Welcome back<span style="color:var(--ok)">.</span></h1>
      <p class="sub">Sign in to the <b><%= botName %></b> console — publishing, queue, guardrails and analytics.</p>

      <% if (error) { %><div class="login-error" role="alert"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 8v5m0 3h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span><%= error %></span></div><% } %>

      <form method="POST" action="/login" id="loginForm" autocomplete="off" novalidate>
        <label>Username
          <span class="field">
            <input name="username" id="fUser" type="text" required autofocus placeholder="admin" autocomplete="username" autocapitalize="none" spellcheck="false">
            <svg class="field-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.7"/><path d="M4.5 20c1.6-3.6 4.4-5.4 7.5-5.4s5.9 1.8 7.5 5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </span>
        </label>
        <label>Password
          <span class="field">
            <input name="password" id="fPass" type="password" required placeholder="••••••••••" autocomplete="current-password">
            <button class="toggle-pw" id="togglePw" type="button" aria-label="Show password" aria-pressed="false">
              <svg id="eyeOn" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.7"/></svg>
              <svg id="eyeOff" width="18" height="18" viewBox="0 0 24 24" fill="none" style="display:none"><path d="M3 3l18 18M10.6 5.9A10.6 10.6 0 0 1 22 12a17 17 0 0 1-3.2 4M6.4 6.4A16.4 16.4 0 0 0 2 12s3.6 6.5 10 6.5c1.6 0 3-.4 4.3-1.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </span>
        </label>
        <div class="row-between">
          <label class="remember"><input type="checkbox" id="rememberMe" checked> Keep this device signed in</label>
          <a class="escape-link" href="/connect">Link a number ↗</a>
        </div>
        <button type="submit" class="btn" id="submitBtn"><span class="spinner" aria-hidden="true"></span><span class="btn-label">Sign in securely</span><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </form>

      <div class="security-strip" aria-label="Security features">
        <span class="sec-chip">Rate-limited</span>
        <span class="sec-chip">Session-signed</span>
        <span class="sec-chip">Read-only role ready</span>
        <span class="sec-chip">Audit-logged</span>
      </div>

      <div class="divider">New here?</div>
      <a class="connect-alt" href="/connect">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="7" y="2.5" width="10" height="19" rx="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M11 18.5h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span><b>Connect a WhatsApp number</b><span>Scan a QR or type a pairing code — sign in first unless public pairing is enabled.</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <p class="foot-note">PROTECTED · LOGINS ARE RATE-LIMITED · ALL ACCESS IS AUDITED</p>
    </div>
  </section>
</main>

<script>
  // theme follows the main dashboard choice
  try { const t = localStorage.getItem('rc-theme') || localStorage.getItem('rq6-theme'); if (t && t !== 'auto') document.documentElement.dataset.theme = t; } catch (e) {}

  // show / hide password
  var pw = document.getElementById('fPass'), tgl = document.getElementById('togglePw');
  var eyeOn = document.getElementById('eyeOn'), eyeOff = document.getElementById('eyeOff');
  tgl.addEventListener('click', function () {
    var showing = pw.type === 'text';
    pw.type = showing ? 'password' : 'text';
    eyeOn.style.display = showing ? '' : 'none';
    eyeOff.style.display = showing ? 'none' : '';
    tgl.setAttribute('aria-pressed', String(!showing));
    tgl.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    pw.focus();
  });

  // JSON login keeps the session + issues a bearer token for the SPA
  var form = document.getElementById('loginForm'), btn = document.getElementById('submitBtn');
  form.addEventListener('submit', async function (ev) {
    ev.preventDefault();
    if (btn.disabled) return;
    btn.disabled = true; btn.classList.add('loading');
    try {
      const res = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ username: form.username.value, password: form.password.value })
      });
      const data = await res.json();
      if (data.ok) { try { localStorage.removeItem('rq6-token'); } catch (e) {} location.href = '/admin'; return; }
      var box = document.querySelector('.login-error') || (() => { const d = document.createElement('div'); d.className = 'login-error'; d.setAttribute('role', 'alert'); form.before(d); return d; })();
      box.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 8v5m0 3h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span></span>';
      box.querySelector('span:last-child').textContent = data.error || 'Login failed.';
    } catch (e) {
      form.submit();
      return;
    }
    btn.disabled = false; btn.classList.remove('loading');
  });
</script>
</body>
</html>
