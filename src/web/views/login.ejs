<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login · <%= botName %></title>
<link rel="icon" href="/pwa/icon-192.png">
<link rel="stylesheet" href="/app.css?v=s15">
</head>
<body class="login-body">
  <div class="login-card">
    <div class="login-logo">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" fill="var(--accent)" opacity=".18"/>
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" stroke="var(--accent)" stroke-width="1.4"/>
        <path d="M8.5 9.2c.3 3 3.3 6 6.3 6.3l1.2-1.5-2.1-1-.9.9c-1-.5-1.9-1.4-2.4-2.4l.9-.9-1-2.1-1.5 1.2a1 1 0 0 0-.5 1.5Z" fill="var(--accent)"/>
      </svg>
    </div>
    <h1><%= botName %></h1>
    <p class="login-sub">Secure workspace sign in</p>
    <% if (error) { %><div class="login-error"><%= error %></div><% } %>
    <form method="POST" action="/login" id="loginForm" autocomplete="off">
      <label>Username
        <input name="username" type="text" required autofocus placeholder="admin">
      </label>
      <label>Password
        <input name="password" type="password" required placeholder="••••••••••">
      </label>
      <button type="submit" class="btn btn-p btn-block">Sign in</button>
    </form>
        <p style="color:var(--text2);font-size:12.5px;margin-top:14px;text-align:center">Have another phone with you? <a href="/connect" style="color:var(--ok,#00a884)">Connect a number ↗</a> — sign in first unless public pairing is explicitly enabled.</p>
    <p class="login-foot">Protected · logins are rate-limited</p>
  </div>
  <script>
    // theme follows the main dashboard choice
    try { const t = localStorage.getItem('rc-theme') || localStorage.getItem('rq6-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    // JSON login keeps the session + issues a bearer token for the SPA
    document.getElementById('loginForm').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.target;
      try {
        const res = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ username: f.username.value, password: f.password.value })
        });
        const data = await res.json();
        if (data.ok) { try { localStorage.removeItem('rq6-token'); } catch (e) {} location.href = '/admin'; }
        else { const box = document.querySelector('.login-error') || (() => { const d = document.createElement('div'); d.className = 'login-error'; f.before(d); return d; })(); box.textContent = data.error || 'Login failed.'; }
      } catch (e) { f.submit(); }
    });
  </script>
</body>
</html>
