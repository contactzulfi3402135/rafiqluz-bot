      <section class="view" data-view="settings" hidden>
      <div class="vtab-row" role="tablist" aria-label="Settings & About">
        <button class="vtab" data-go="settings" role="tab">Settings</button>
        <button class="vtab" data-go="about" role="tab">About</button>
      </div>

        <div class="ph"><div class="ph-l"><h2>Settings</h2><div class="ph-d">Everything the bot can be told — eight sections, one at a time. Every change saves with its own button on the spot. The WhatsApp mirror is always left exactly as WhatsApp renders it.</div></div></div>
        <div class="set-wrap">
          <!-- Reskin §7.5/§8: spec's eight tabs over the app's existing field cards.
               Tab wiring is attribute-generic (data-setgroup / data-sets), zero JS changes.
               Existing group keys kept where possible (general, whatsapp, automation, ai,
               data) so remembered tabs in localStorage keep resolving. -->
          <nav class="set-nav settings-rail" id="setNav" role="tablist" aria-label="Settings sections">
      <button class="set-tab on" data-setgroup="general" role="tab" tabindex="0"><%- icon('globe','icon icon-sm') %><span class="lbl">General</span></button>
      <button class="set-tab" data-setgroup="whatsapp" role="tab" tabindex="0"><%- icon('chat','icon icon-sm') %><span class="lbl">WhatsApp</span></button>
      <button class="set-tab" data-setgroup="pacing" role="tab" tabindex="0"><%- icon('gauge','icon icon-sm') %><span class="lbl">Pacing</span></button>
      <button class="set-tab" data-setgroup="automation" role="tab" tabindex="0"><%- icon('zap','icon icon-sm') %><span class="lbl">Automation</span></button>
      <button class="set-tab" data-setgroup="ai" role="tab" tabindex="0"><%- icon('bot','icon icon-sm') %><span class="lbl">AI &amp; Rules</span></button>
      <button class="set-tab" data-setgroup="notifications" role="tab" tabindex="0"><%- icon('mail','icon icon-sm') %><span class="lbl">Notifications</span></button>
      <button class="set-tab" data-setgroup="data" role="tab" tabindex="0"><%- icon('database','icon icon-sm') %><span class="lbl">Storage</span></button>
      <button class="set-tab" data-setgroup="options" role="tab" tabindex="0"><%- icon('sliders','icon icon-sm') %><span class="lbl">33 Options</span></button>
          </nav>
          <div class="set-body" id="setBody">

      <div class="set-group on" role="tabpanel" data-setgroup="general">
        <div class="card cat">
          <div class="card-h"><%- icon('tag','icon') %> Branding</div>
          <div class="card-b">
            <div class="row-form"><input class="in" id="setBotName" placeholder="Bot name (shown in the dashboard)"><button class="btn btn-p" id="setSave" style="flex:none">Save</button></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('sliders','icon') %> Dashboard</div>
          <div class="card-b">
            <div class="sw-card">
              <div class="s-txt">
                <div class="s-name">Show channel IDs</div>
                <div class="s-desc">Show each channel's ID in small monospace text inside channel pickers. Off by default — names are enough for normal use.</div>
              </div>
              <label class="sw"><input type="checkbox" id="showJidSw"><i></i></label>
            </div>
            <!-- 5J (J10): language — English or Urdu (RTL, best-effort labels) -->
            <div class="row-form" style="margin-top:12px">
              <label>Language</label>
              <select class="in" id="setLang" style="flex:none;width:auto" title="English (LTR) or Urdu (RTL — best-effort labels)">
                <option value="en">English (LTR)</option>
                <option value="ur">اردو (RTL)</option>
              </select>
              <span class="muted tiny">Urdu flips the whole console to right-to-left — best effort, the WhatsApp mirror stays as WhatsApp renders it.</span>
            </div>
            <!-- Reference §1.4: theme lives in Workspace & language (the sidebar icon keeps working too) -->
            <div class="row-form" style="margin-top:12px">
              <label>Theme</label>
              <div class="radio-line" id="themeRadios">
                <button type="button" class="radio-pill" data-theme-choice="dark">Dark</button>
                <button type="button" class="radio-pill" data-theme-choice="light">Light</button>
                <button type="button" class="radio-pill" data-theme-choice="glass">Glass</button>
                <button type="button" class="radio-pill" data-theme-choice="auto">System</button>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><%- icon('lock','icon') %> Security <span class="muted tiny">— a second password that can look but never change</span></div>
          <div class="card-b">
            <div class="row-form" style="align-items:center">
              <label class="sw" title="Enable the second (read-only) password"><input type="checkbox" id="roEnable"><i></i></label>
              <span>Second password (read-only session)</span>
            </div>
            <p class="muted tiny">Use it to hand the dashboard to a family member or a technician: they can open every view and read everything, but every change is blocked. Their session is labeled READ-ONLY at the top.</p>
            <div class="row-form wrap" style="margin-top:10px">
              <input class="in" id="roPass" type="password" placeholder="New read-only password (min 6 chars)" style="flex:1;min-width:220px;height:30px;font-size:var(--t13)" autocomplete="new-password">
              <label class="sw" title="Email you whenever a dashboard session is opened"><input type="checkbox" id="loginAlerts"><i></i></label>
              <span>Alert me by email on dashboard logins</span>
            </div>
            <div class="row-form wrap" style="margin-top:10px">
              <input class="in num" id="timeoutMin" type="number" min="5" max="1440" style="flex:none;width:90px;height:30px;font-size:var(--t13)" title="Idle session timeout (minutes)">
              <span>Log me out after this much idle time (minutes)</span>
              <button class="btn btn-sm" id="secSave" style="margin-left:auto">Save security</button>
            </div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('key','icon') %> Owner API key</div>
          <div class="card-b">
            <p class="muted tiny f-help">For external scripts: send <code>x-api-key</code> with this value to call the bot's API (same rights as the dashboard).</p>
            <div class="row-form" style="margin-top:12px"><input class="in" id="apiKeyBox" readonly><button class="btn btn-p" id="apiKeyRegen" style="flex:none"><%- icon('refresh','icon icon-xs') %> Regenerate</button></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('user','icon') %> Session</div>
          <div class="card-b">
            <div class="row-actions" style="margin-top:0"><a class="btn btn-d" href="/logout"><%- icon('x','icon icon-xs') %> Sign out</a></div>
            <p class="muted tiny f-help" style="margin-top:8px">Cloud memory, QR safety and self-heal are automatic — nothing to configure here. Read-only login and session timeout are live in this same card.</p>
          </div>
        </div>
        <div class="set-footbar"><b>33 optional switches</b><span class="muted">— all off by default, each lives on its own screen. Full index:</span><a class="text-link" href="#view=settings">Open 33 Options →</a></div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="whatsapp">
        <div class="card cat">
          <div class="card-h"><%- icon('chat','icon') %> Chat features <span class="muted tiny">— per connected number</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">These work on every connected number's chats, live in the WhatsApp tab. Anti-delete / anti-view-once / anti-edit are ON as you asked; call auto-reject is OFF so calls still ring on the phone.</p>
            <div id="setFeats" style="margin-top:8px"></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('phone','icon') %> WhatsApp command channel</div>
          <div class="card-b">
            <div class="sw-grid" id="swWaCommand"></div>
            <p class="muted tiny f-help" style="margin-top:8px">Message YOURSELF on WhatsApp (the “message yourself” chat) with a command. Locked to your number only — no one else can trigger it. Destructive commands need a PIN. Every command is logged and mirrored into the AI assistant chat.</p>
            <div class="row-form wrap" style="margin-top:10px">
              <input class="in" id="waPin" placeholder="Command PIN (4–8 digits, empty = destructive off)" style="flex:1;min-width:220px" inputmode="numeric">
              <button class="btn btn-p" id="waPinSave" style="flex:none">Save PIN</button>
            </div>
            <span class="muted tiny" id="waPinState"></span>
            <div class="tw" style="margin-top:10px"><table class="t" id="waCmdTable"><thead><tr><th class="mono">Command</th><th>What it does</th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('lock','icon') %> WhatsApp mirror <span class="pill ok">Locked</span></div>
          <div class="card-b"><p class="muted tiny f-help">The WhatsApp tab copies WhatsApp's own look — colors, layout, spacing. It is never themed, never re-skinned, and always stays left-to-right, exactly as WhatsApp renders it. Nothing below changes it.</p></div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="pacing">
        <div class="card cat">
          <div class="card-h"><%- icon('filter','icon') %> Pipeline behavior</div>
          <div class="card-b">
            <div class="row-form wrap">
              <label class="sw-inline"><span>Cross-source dedupe window (minutes)</span><input class="in" id="setXdedupeWin" type="number" min="1" max="1440" style="flex:none;width:110px" title="Same story from another source within this window counts as a duplicate"></label>
            </div>
            <div class="row-form" style="margin-top:12px">
              <select class="in" id="setSourceEdit" title="What happens when a source edits one of its published posts" style="flex:none">
                <option value="ignore">When a source edits its post: ignore (default)</option>
                <option value="mark">When a source edits its post: mark as edited</option>
                <option value="update">When a source edits its post: update the live post (needs Edit posts ON)</option>
              </select>
              <button class="btn btn-p" id="set5aSave" style="flex:none">Save</button>
            </div>
            <p class="muted tiny f-help" style="margin-top:8px">The cross-source dedupe switch lives in Guardrails. The approval-queue delay buffer lives in the Approval Queue tab. Undo of a last published post lives in Posts.</p>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('gauge','icon') %> Where the rest of pacing lives</div>
          <div class="card-b">
            <p class="muted tiny f-help">The rate-guard cap, per-target rate caps, the 24-hour pacing visualizer and the freshness guard live on the <a class="text-link" href="#view=guardrails">Rules screen</a> — the delay buffer (minutes every post waits before publishing) lives on the <a class="text-link" href="#view=approvals">Queue screen</a>, and the delivery rate controller is shown on <a class="text-link" href="#view=home">Home</a>.</p>
          </div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="automation">
        <div class="card cat">
          <div class="card-h"><%- icon('sliders','icon') %> Posting switches <span class="muted tiny">— how every post is cleaned and shaped · all off by default</span></div>
          <div class="card-b"><div class="sw-grid" id="swGeneral"></div></div>
        </div>
        <div class="card">
          <div class="card-h">Automation <%- icon('zap','icon') %> <span class="muted tiny">— the bot working for you, all off by default</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">The Auto-pilot switch itself lives in Intelligence · AI Pilot (one home); its daily limit and full log are below. The WhatsApp command channel lives in Settings · Integrations &amp; reports.</p>
            <h3 style="margin-top:16px;font-size:var(--t14);font-weight:600">Auto-pilot</h3>
            <p class="muted tiny f-help">An hourly self-maintenance pass: it re-queues failed items, re-feeds failed posts and unsticks zombie queue rows. Hard caps — a daily action limit, it <b>never deletes anything</b> and never touches settings or keys, and the panic stop kills it instantly. Its full log is below the limit.</p>
            <div class="row-form wrap" style="margin-top:10px">
              <input class="in num" id="apMax" placeholder="Max actions per day" style="flex:none;width:170px" inputmode="numeric">
              <button class="btn btn-p" id="apSave" style="flex:none">Save limit</button>
              <span class="muted tiny" id="apState" style="align-self:center"></span>
            </div>
            <div class="tw" style="margin-top:10px"><table class="t" id="apLog"><thead><tr><th>When</th><th>Action</th><th>Detail</th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="ai">
        <div class="card cat">
          <div class="card-h"><%- icon('bot','icon') %> AI provider <span class="pill" id="aiProviderCount"></span></div>
          <div class="card-b">
            <p class="muted tiny f-help">20 providers supported — every one works with the bot. Ones marked <b>free</b> have a free tier. Pick one, then click the button below to get its API key (opens in a new tab).</p>
            <div class="row-form wrap" style="margin-top:12px">
              <select class="in" id="aiProvider" title="Which AI to use"></select>
              <select class="in" id="aiModel" title="Model of the selected AI"></select>
            </div>
            <div class="row-form wrap" style="margin-top:12px">
              <button class="btn" id="aiModelRefresh" type="button" title="Ask the provider for its current model list" style="flex:none"><%- icon('refresh','icon icon-xs') %> Fetch live model list</button>
              <input class="in" id="aiModelCustom" placeholder="…or type any custom model id (used instead of the picker)">
            </div>
            <p class="muted tiny" id="aiModelNote" style="margin-top:6px"></p>
            <a class="btn btn-p" id="aiGetKey" href="#" target="_blank" rel="noopener noreferrer" style="margin-top:8px"><%- icon('key','icon icon-xs') %> Get API key →</a>
            <div class="row-form" style="margin-top:12px">
              <input class="in" id="aiKey" type="password" placeholder="API key">
              <button class="btn btn-p" id="aiSave" style="flex:none">Save AI settings</button>
            </div>
            <p class="muted tiny" id="aiKeyLine" style="margin-top:6px"></p>
            <div class="row-actions" style="margin-top:4px">
              <button class="btn" id="aiTest"><%- icon('zap','icon icon-xs') %> Test connection</button>
              <span class="muted tiny" id="aiTestResult"></span>
            </div>
            <p class="muted tiny" id="aiStateLine" style="margin-top:6px"></p>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('bot','icon') %> AI per feature <span class="muted tiny" id="aiFeatTotal"></span></div>
          <div class="card-b">
            <p class="muted tiny f-help">Each AI feature can use its OWN provider and model — e.g. a fast free model for cleaning posts, a stronger one for the assistant. Leave a row on “(global)” to follow the main AI choice above. The meter counts real calls and tokens per feature.</p>
            <div class="tw" style="margin-top:12px"><table class="t" id="aiFeatTable"><thead><tr><th>Feature</th><th>Provider</th><th>Model</th><th>Calls</th><th>Tokens</th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('file-text','icon') %> Prompt library</div>
          <div class="card-b">
            <p class="muted tiny f-help">Reusable AI prompts for the Composer (the “Library prompt” button). Ten come built-in; you can edit any of them and add your own.</p>
            <div id="promptLibList" style="margin-top:12px"><span class="muted tiny">Loading…</span></div>
            <div class="row-form wrap" style="margin-top:12px">
              <input class="in" id="plName" placeholder="New prompt name">
              <button class="btn btn-g" id="plAdd">Add prompt</button>
            </div>
            <div class="field" style="margin-top:8px"><textarea class="in" id="plBody" rows="3" placeholder="The prompt text — it receives the composer's post."></textarea></div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('languages','icon') %> Glossary (enforced terms)</div>
          <div class="card-b">
            <p class="muted tiny f-help">Your terms win over the AI: every “term” is replaced by its “replacement” in translated posts and in the final template output. Case-insensitive.</p>
            <div id="glossaryList" style="margin-top:12px"><span class="muted tiny">No terms yet.</span></div>
            <div class="row-form wrap" style="margin-top:12px">
              <input class="in" id="glFrom" placeholder="Term, e.g. App">
              <input class="in" id="glTo" placeholder="Replacement, e.g. the app">
              <input class="in" id="glNote" placeholder="Note (optional)">
              <button class="btn btn-g" id="glAdd">Add term</button>
            </div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('bot','icon') %> Where the rest of AI lives</div>
          <div class="card-b">
            <p class="muted tiny f-help">The AI pilot rule and evergreen / auto-pilot limits live on the <a class="text-link" href="#view=aipilot">AI Pilot screen</a> · auto-reply instruction and knowledge base on the <a class="text-link" href="#view=aireply">Auto-replies screen</a> · the AI safety-screen criteria on the <a class="text-link" href="#view=guardrails">Rules screen</a>.</p>
          </div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="notifications">
        <div class="card cat">
          <div class="card-h"><%- icon('mail','icon') %> Daily WhatsApp report</div>
          <div class="card-b">
            <div class="row-form"><input class="in" id="setReportPhone" placeholder="Your phone, e.g. 923001234567"><button class="btn btn-p" id="setReportSave" style="flex:none">Save</button></div>
            <p class="muted tiny f-help" style="margin-top:8px">Sent at 21:00 Pakistan time — published / failed / skipped counts for the day.</p>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('mail','icon') %> Where the rest of notifications lives</div>
          <div class="card-b">
            <p class="muted tiny f-help">Daily digest, morning recap, weekly report and instant alerts — each with its own switch, time and test button — live together on the <a class="text-link" href="#view=digest">Reports &amp; Digest screen</a>. The bot has no separate email accounts to configure; email goes out only if a sender is already connected in the Email screen.</p>
          </div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="data">
        <div class="card">
          <div class="card-h"><%- icon('database','icon') %> Backup &amp; restore <span class="muted tiny">— the whole bot state, local to you</span></div>
          <div class="card-b">
            <p class="muted tiny">A backup zip contains the complete database: settings, sources, targets, posts, logs, the audit trail and your API keys. Keep it private — it is your password, in a file.</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
              <button class="btn btn-p" id="bkDownload"><%- icon('download','icon icon-xs') %> Download backup (.zip)</button>
              <label class="btn" style="cursor:pointer"><%- icon('upload','icon icon-xs') %> Restore from backup<input type="file" id="bkRestoreFile" accept=".zip,.sqlite,.db" hidden></label>
              <span class="muted tiny" id="bkRestoreMsg" style="align-self:center"></span>
            </div>
            <div style="margin-top:12px"><b class="tiny">Pre-restore snapshots</b> <span class="muted tiny">— a snapshot is made automatically before EVERY restore, so a restore can itself be undone (last 5 kept)</span>
              <div class="tw" style="margin-top:8px"><table class="t" id="bkPreTable"><thead><tr><th>Snapshot</th><th class="num">Size</th><th></th></tr></thead><tbody></tbody></table></div>
            </div>
          </div>
        </div>
        <div class="card cat">
          <div class="card-h"><%- icon('cloud','icon') %> Cloud memory &amp; exports</div>
          <div class="card-b">
            <div class="row-actions" style="margin-top:0">
              <button class="btn btn-p" id="backupNow"><%- icon('cloud','icon icon-xs') %> Back up now</button>
              <a class="btn" href="/api/export/posts.csv" download><%- icon('download','icon icon-xs') %> Export posts CSV</a>
              <a class="btn" href="/api/export/logs.csv" download><%- icon('download','icon icon-xs') %> Export logs CSV</a>
            </div>
            <p class="muted tiny" id="backupResult" style="margin-top:8px"></p>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><%- icon('database','icon') %> Storage <span class="muted tiny">— what the bot keeps on disk, and how to trim it</span></div>
          <div class="card-b">
            <div class="kpis" id="stKpis"></div>
            <!-- v8.3.0: GitHub repo storage gauge — real size of the whole repo (what a clone downloads) -->
            <div id="ghGauge" style="margin-top:12px;padding:10px 12px;border:1px solid var(--bd);border-radius:10px;background:var(--card2)">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <b class="tiny">GitHub repo storage</b>
                <span class="muted tiny">— how big a full clone of the repo would be (all code + every version + cloud-memory backup)</span>
                <button class="btn btn-sm" id="ghGaugeRefresh" style="margin-left:auto;flex:none"><%- icon('refresh','icon icon-xs') %> Refresh</button>
              </div>
              <div class="row-form wrap" style="margin-top:8px">
                <span class="num" id="ghGaugeSize" style="font-weight:600;font-size:var(--t15)">—</span>
                <span class="muted tiny" id="ghGaugeDetail"></span>
              </div>
            </div>
            <!-- v9.0.0 (repo-slim): keep the repo small + the login QR-free -->
            <div id="slimBox" style="margin-top:12px;padding:10px 12px;border:1px solid var(--bd);border-radius:10px;background:var(--card2)">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <b class="tiny">Keep the repo small</b>
                <span class="muted tiny">— media of any size is saved on disk, and the moment a post's media is published to a target channel its local copy is deleted; previews that are never posted are pruned by the age above; the cloud login syncs only when something actually changes</span>
              </div>
              <div class="row-form wrap" style="margin-top:8px">
                <button class="btn btn-sm" id="slimCompact"><%- icon('minimize','icon icon-xs') %> Compact cloud memory now</button>
                <span class="muted tiny" id="slimCompactNote">Rewrites the backup branch with exactly one fresh snapshot — GitHub drops the older copies on its next cleanup.</span>
              </div>
              <div class="row-form wrap" style="margin-top:8px">
                <span class="muted tiny">Inbox photos kept for</span>
                <input class="in num" id="slimKeepDays" type="number" min="1" max="365" value="30" style="flex:none;width:76px;height:30px;font-size:var(--t13)" title="Days to keep WhatsApp-tab photos before they are deleted">
                <span class="muted tiny">days</span>
                <button class="btn btn-sm" id="slimKeepSave">Save</button>
                <span class="muted tiny" id="slimInboxNow"></span>
              </div>
            </div>
            <div class="row-form wrap" style="margin-top:12px">
              <input class="in num" id="clDays" type="number" min="1" max="365" value="30" style="flex:none;width:84px;height:30px;font-size:var(--t13)" title="Age in days">
              <span>older than</span>
              <button class="btn btn-sm" id="clMedia">Clean media</button>
              <button class="btn btn-sm" id="clLogs">Trim logs</button>
              <button class="btn btn-sm" id="clFailed">Trim old failed/skipped posts</button>
              <button class="btn btn-sm" id="clVacuum">Vacuum DB</button>
            </div>
            <p class="muted tiny" style="margin-top:8px">Cleaning never touches published posts, settings or credentials. Every cleanup is written to the Audit trail.</p>
          </div>
        </div>
      </div>
      <div class="set-group" role="tabpanel" data-setgroup="options">
        <div class="card">
          <div class="card-h"><%- icon('sliders','icon') %> All 33 optional switches <span class="pill num">33</span></div>
          <div class="card-b">
            <p class="muted tiny f-help" style="margin-bottom:12px">Every automation the bot can do, in one place — read-only here. Each switch keeps its own home screen (one home per switch), where it is turned on or off with its sub-settings. "Configure" jumps to that home. None of the 33 are on by default.</p>
            <div class="opt-index">
          <div class="opt-h">Publish pipeline</div>
          <div class="opt-row"><b>Scheduler</b><span class="muted tiny">Publish queued posts at their scheduled time</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-row"><b>Smart dedupe</b><span class="muted tiny">Skip near-duplicate posts within 12 hours</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-row"><b>Cross-source dedupe</b><span class="muted tiny">Same story from 2+ sources in the window publishes once, with merged via-credits</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-row"><b>Split long posts</b><span class="muted tiny">Posts over 4096 characters become numbered parts, media on part 1</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-row"><b>Polls to text</b><span class="muted tiny">Publish channel polls as a text post (question + options) instead of skipping them</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-row"><b>Smart media checks</b><span class="muted tiny">Before publish: media must match its kind and stay under the size caps (image 10 MB · video 40 MB · document 20 MB) — otherwise an honest skip, no compression</span><a class="text-link" href="#view=settings">Configure →</a></div>
          <div class="opt-h">Formatting</div>
          <div class="opt-row"><b>AI beautify</b><span class="muted tiny">AI cleans and titles every post (regex clean always on)</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Auto headers</b><span class="muted tiny">Add a category header line (JOBS, NEWS…)</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Auto hashtags</b><span class="muted tiny">Append #jobs #news style tags</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>AI translate</b><span class="muted tiny">Translate every post to your chosen language first</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>TL;DR line</b><span class="muted tiny">Long posts get a 1-line summary on top (AI — skipped automatically if AI is unavailable)</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Auto-bold key phrases</b><span class="muted tiny">AI bolds the 1–3 most important phrases of every post with *asterisks*</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Emoji bullets</b><span class="muted tiny">Bullet lines get rotating emoji bullets (deterministic, no AI)</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Signature (footer)</b><span class="muted tiny">Append your signature/footer to every published post</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-row"><b>Link cleanup</b><span class="muted tiny">Strip tracking params (utm_*, fbclid, gclid…) from URLs in the final post text — everything else stays untouched</span><a class="text-link" href="#view=branding">Configure →</a></div>
          <div class="opt-h">AI Pilot</div>
          <div class="opt-row"><b>AI pilot</b><span class="muted tiny">AI decides which posts are worth publishing</span><a class="text-link" href="#view=aipilot">Configure →</a></div>
          <div class="opt-row"><b>Evergreen recycling</b><span class="muted tiny">Re-share proven older text posts within a daily quota (rotation + rate guard)</span><a class="text-link" href="#view=aipilot">Configure →</a></div>
          <div class="opt-row"><b>Auto-pilot</b><span class="muted tiny">Hourly self-maintenance: retry failed items, never deletes, daily cap, panic stop kills it</span><a class="text-link" href="#view=aipilot">Configure →</a></div>
          <div class="opt-h">Safety screen</div>
          <div class="opt-row"><b>AI safety screen</b><span class="muted tiny">An AI criteria review of the FINAL text before routing — e.g. &quot;no political content&quot;. Fail-open: if the AI is down the post publishes as usual</span><a class="text-link" href="#view=guardrails">Configure →</a></div>
          <div class="opt-h">Reports & Digest</div>
          <div class="opt-row"><b>AI daily digest</b><span class="muted tiny">Once a day, AI posts a summary of everything published</span><a class="text-link" href="#view=digest">Configure →</a></div>
          <div class="opt-row"><b>Morning recap</b><span class="muted tiny">Daily plain-text recap of yesterday (published/skipped/failed + up next) sent to your own number</span><a class="text-link" href="#view=digest">Configure →</a></div>
          <div class="opt-row"><b>Weekly report</b><span class="muted tiny">A plain-text week summary to your own number + email (if connected) on the day and time below</span><a class="text-link" href="#view=digest">Configure →</a></div>
          <div class="opt-row"><b>Instant alerts</b><span class="muted tiny">The moment something fails (post, WhatsApp, crash) you get a WhatsApp alert — 30-min cooldown per type</span><a class="text-link" href="#view=digest">Configure →</a></div>
          <div class="opt-h">Replies</div>
          <div class="opt-row"><b>AI auto-reply</b><span class="muted tiny">AI answers personal WhatsApp messages for you (10-min per-chat limit)</span><a class="text-link" href="#view=aireply">Configure →</a></div>
          <div class="opt-row"><b>Voice transcription</b><span class="muted tiny">Voice messages in your chats are turned into text (needs a Gemini key — Settings · AI)</span><a class="text-link" href="#view=aireply">Configure →</a></div>
          <div class="opt-row"><b>Knowledge-base replies</b><span class="muted tiny">Stored question → answer pairs, sent exactly (no AI). Hours + allowlist below; empty allowlist = nobody</span><a class="text-link" href="#view=aireply">Configure →</a></div>
          <div class="opt-h">Approval queue</div>
          <div class="opt-row"><b>Approval queue</b><span class="muted tiny">Posts from &quot;approve first&quot; sources wait here for your OK; the delay buffer also waits here</span><a class="text-link" href="#view=approvals">Configure →</a></div>
          <div class="opt-h">History</div>
          <div class="opt-row"><b>Edit posts</b><span class="muted tiny">Edit or delete already-published posts (experimental)</span><a class="text-link" href="#view=posts">Configure →</a></div>
          <div class="opt-h">Routing</div>
          <div class="opt-row"><b>Smart routing</b><span class="muted tiny">Per-target include / exclude / media rules</span><a class="text-link" href="#view=routing">Configure →</a></div>
          <div class="opt-row"><b>Routing matrix</b><span class="muted tiny">Apply the explicit source × target on/off grid (off = current mapping behavior)</span><a class="text-link" href="#view=routing">Configure →</a></div>
          <div class="opt-h">Analytics</div>
          <div class="opt-row"><b>Analytics</b><span class="muted tiny">Per-day, per-source and failure counters</span><a class="text-link" href="#view=analytics">Configure →</a></div>
          <div class="opt-h">Library</div>
          <div class="opt-row"><b>Announcement cards</b><span class="muted tiny">Make a branded 1080×1080 PNG card (with SVG source) from any post — a manual tool, never auto-attached</span><a class="text-link" href="#view=media">Configure →</a></div>
          <div class="opt-h">WhatsApp command channel</div>
          <div class="opt-row"><b>WA command channel</b><span class="muted tiny">Run the bot from your own WhatsApp number — status, approve, undo… (destructive needs the PIN)</span><a class="text-link" href="#view=settings">Configure →</a></div>
            </div>
          </div>
        </div>
      </div>

      </div>
        </div>
      </section>

      <!-- ═══ SYSTEM · ABOUT (arrives in 5J · J9) ═══ -->
      <section class="view" data-view="about" hidden>
      <div class="vtab-row" role="tablist" aria-label="Settings & About">
        <button class="vtab" data-go="settings" role="tab">Settings</button>
        <button class="vtab" data-go="about" role="tab">About</button>
      </div>

        <div class="ph"><div class="ph-l"><h2>About</h2><div class="ph-d">Version, changelog, last deploy and a quick health snapshot.</div></div></div>
        <div class="card">
          <div class="card-h">API explorer <%- icon('terminal','icon') %> <span class="muted tiny">— try the bot's own endpoints</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">Every endpoint the dashboard uses, grouped. <b>Try it</b> runs the call from your session and shows the raw response — the same JSON the UI works with. GETs are read-only; POSTs here do the same thing the buttons do (so double-check destructive ones).</p>
            <div class="row-form" style="margin-top:12px"><input class="in" id="apiExSearch" placeholder="Filter endpoints…" style="flex:1" autocomplete="off"></div>
            <div id="apiExList" style="margin-top:12px"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Raqifluz <%- icon('zap','icon') %> <span class="pill num" id="abVersion">v<%= version %></span></div>
          <div class="card-b">
            <p class="muted tiny">WhatsApp channel mirroring bot — one linked number, many channels, full control. Express + EJS + vanilla JS on a single process; SQLite for state; the WhatsApp link (bot-state) is the only moving part, and it is never touched by an update.</p>
            <div class="row-form wrap" style="margin-top:10px">
              <span class="muted tiny" id="abUptime">uptime —</span>
              <span class="muted tiny" id="abDeploy">last boot —</span>
              <span class="muted tiny" id="abStorage">storage —</span>
              <span class="muted tiny">signed in as <b id="abUser"><%= username %></b></span>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Changelog <%- icon('history','icon') %></div>
          <div class="card-b" id="abChangelog"></div>
        </div>
      </section>

    </main>
  </div>
</div>

<!-- bottom tab bar (<640) — Meridian 2: Home · Channels · Compose (raised center) · Publish · Inbox · More -->
<!-- Signal Desk mobile shell (§2.6): five items — Home · Queue · raised Compose · Channels · More -->
<nav class="btabs" aria-label="Quick">
  <button class="bt" data-view="home" data-lbl="Home"><%- icon('layout-dashboard') %><span>Home</span></button>
  <button class="bt" data-view="approvals" data-lbl="Queue"><%- icon('inbox') %><span>Queue</span></button>
  <button class="bt bt-fab" data-view="newpost" data-lbl="Compose" aria-label="Compose" title="Compose"><%- icon('pen') %></button>
  <button class="bt" data-view="sources" data-lbl="Channels"><%- icon('radio') %><span>Channels</span></button>
  <button class="bt" id="btMoreBtn" data-lbl="More" aria-label="More — everything else"><%- icon('grid') %><span>More</span></button>
</nav>

<!-- More sheet (<640) — everything that does not fit the five main slots, grouped by area -->
<div class="sheet-scrim" id="moreScrim" hidden>
  <div class="sheet" role="dialog" aria-label="More">
    <div class="sheet-h"><b>More</b><button class="icon-btn" id="moreClose" aria-label="Close"><%- icon('x','icon icon-sm') %></button></div>
    <div class="sheet-b" id="moreList"></div>
  </div>
</div>

<!-- Meridian 2 first-run wizard — 5 steps, skippable, resumable, re-openable.
     Shown until WhatsApp is linked; goal is a first published post in under 5 minutes. -->
<div class="wiz-scrim" id="wizScrim" hidden>
  <div class="wiz" role="dialog" aria-label="Setup wizard">
    <div class="wiz-h">
      <b id="wizTitle">Welcome</b>
      <span class="wiz-step" id="wizStepLbl">1 of 5</span>
      <button class="btn btn-ghost btn-sm" id="wizSkip">Skip for now</button>
    </div>
    <div class="wiz-b" id="wizBody"></div>
    <div class="wiz-f">
      <div class="wiz-dots" id="wizDots" aria-hidden="true"></div>
      <span style="flex:1"></span>
      <button class="btn btn-g" id="wizBack" hidden>Back</button>
      <button class="btn btn-p" id="wizNext">Next</button>
    </div>
  </div>
</div>

<!-- 60-second tour (optional, offered from the wizard) -->
<div class="tour-scrim" id="tourScrim" hidden>
  <div class="tour" role="dialog" aria-label="60 second tour">
    <div class="tour-b" id="tourBody"></div>
    <div class="tour-f"><span class="muted tiny" id="tourCount">Stop 1 of 5</span><span style="flex:1"></span><button class="btn btn-ghost btn-sm" id="tourDone">End tour</button><button class="btn btn-p btn-sm" id="tourNext">Next stop</button></div>
  </div>
</div>

<!-- command palette -->
<div class="pal-scrim" id="palScrim" hidden>
  <div class="pal" role="dialog" aria-label="Command palette">
    <input class="pal-in" id="palInput" placeholder="Jump to a view, setting or action…" autocomplete="off" spellcheck="false" aria-label="Search">
    <div class="pal-list" id="palList"></div>
    <div class="pal-f"><span><b>↑↓</b> move</span><span><b>↵</b> open</span><span><b>esc</b> close</span></div>
  </div>
</div>

<!-- 5J (J3): "?" help overlay — every switch + feature in one line, searchable -->
<div class="help-scrim" id="helpScrim" hidden>
  <div class="help-panel" role="dialog" aria-label="What each switch does">
    <div class="help-h">
      <b>What does everything do?</b>
      <span class="muted tiny">every switch in the bot, in one line each — click a line to open it</span>
      <button class="icon-btn" id="helpClose" title="Close" aria-label="Close">×</button>
    </div>
    <input class="in" id="helpSearch" placeholder="Filter — e.g. “dedupe”, “AI”…" autocomplete="off">
    <div class="help-list" id="helpList"></div>
  </div>
</div>

<!-- modal root (filled by app.js) -->
<div id="mRoot"></div>
<div class="toasts" id="toasts" aria-live="polite"></div>

<!-- floating AI assistant -->
<div class="rfab" id="robotFab" title="AI assistant — click to chat, drag to move" role="button" aria-label="Open AI assistant" tabindex="0"><%- icon('robot') %></div>
<div class="rpanel" id="robotPanel" hidden role="dialog" aria-label="AI assistant">
  <div class="rhead" id="robotDrag">
    <span class="rtitle"><%- icon('robot','icon icon-xs') %> AI assistant</span>
    <label class="sw" title="When ON, the AI can act on your behalf. Every action shows as a tool line here and in Logs. Off by default."><input type="checkbox" id="aiControlToggle"><i></i><span class="rctl-lbl">Bot control</span></label>
    <button class="icon-btn" id="robotExpand" title="Expand / restore chat" aria-label="Expand chat"><%- icon('expand','icon icon-xs') %></button>
    <button class="icon-btn" id="aiChatClear" title="Clear chat history" aria-label="Clear history"><%- icon('trash','icon icon-xs') %></button>
    <button class="icon-btn" id="robotClose" title="Close" aria-label="Close"><%- icon('x','icon icon-xs') %></button>
    <span class="rstate muted" id="robotState"></span>
  </div>
  <div class="rlog" id="robotLog"></div>
  <div class="rchips" id="robotChips"></div>
  <div class="rin">
    <input class="in" id="robotInput" placeholder="Talk to your bot — e.g. post the missed posts" autocomplete="off" aria-label="Message the assistant">
    <button class="btn btn-p" id="robotSend" title="Send" aria-label="Send"><%- icon('send','icon icon-xs') %></button>
  </div>
</div>
<script src="/app.js?v=s12"></script>
</body>
</html>
