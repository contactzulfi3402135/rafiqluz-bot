            <div class="sw-grid" id="swWeekly"></div>
            <div class="row-form wrap" style="margin-top:8px">
              <input class="in" id="weeklyAt" placeholder="Mon 09:00" style="flex:none;width:110px;height:30px;font-size:var(--t13)" title="Day and time (PKT)" aria-label="Weekly report time">
              <button class="btn btn-sm" id="weeklyAtSave">Save time</button>
              <button class="btn btn-sm" id="weeklySend" title="Send the weekly report right now"><%- icon('send','icon icon-xs') %> Send now</button>
              <span class="muted tiny" id="weeklyLast"></span>
            </div>
            <div class="muted tiny" id="weeklyPreview"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Instant alerts <span class="muted tiny">— 30-minute cooldown per type, so a failure storm never becomes a message storm</span></div>
