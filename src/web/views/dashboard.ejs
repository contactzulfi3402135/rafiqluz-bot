              <div class="ww-filters">
                <button class="ww-pill active" data-f="all">All</button>
                <button class="ww-pill" data-f="unread">Unread</button>
                <button class="ww-pill" data-f="archived">Archived</button>
              </div>
              <a class="ww-openwa" href="https://web.whatsapp.com" target="_blank" rel="noopener" title="WhatsApp blocks other sites from embedding it — open the real WhatsApp Web in a new tab">Open real WhatsApp Web ↗</a>
