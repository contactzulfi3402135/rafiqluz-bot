<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title><%= botName %> · v<%= version %></title>
<!-- 5G (R83): PWA — installable, offline shell, quick shortcuts -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#0b1220">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="/pwa/icon-192.png">
<link rel="icon" href="/pwa/icon-192.png" sizes="192x192">
<script>
/* theme before first paint (dark / light / glass / auto, persisted) */
try {
  var __t = localStorage.getItem('rc-theme') || localStorage.getItem('rq6-theme') || 'dark';
  if (__t === 'auto') __t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  document.documentElement.dataset.theme = __t;
} catch (e) {}
</script>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/noto-sans-arabic-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/noto-sans-arabic-arabic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/app.css?v=s13">
</head>
<body>
<div class="app" id="app">

  <!-- ═══ SIGNAL DESK RAIL (v9.1.0) ═══
     Eight groups, 25 screens (product spec §1.3): Command · Broadcast ·
     Channels · People · Studio · Intelligence · Insights · System.
     Active screen = 3 px citron rail. Phone: drawer + 5-item bottom bar. -->
  <aside class="sidebar" id="sidebar" aria-label="Primary">
    <!-- Signal Desk shell (reference): brand lockup — rotated R mark + name + SIGNAL DESK -->
    <div class="sb-head">
      <span class="sb-logo brand-mark" aria-hidden="true">R</span>
      <span class="brand-copy">
        <span class="sb-name" id="brandName"><%= botName %></span>
        <span class="brand-sub">SIGNAL DESK</span>
      </span>
      <button class="icon-btn sb-collapse" id="sbCollapse" title="Collapse sidebar" aria-label="Collapse sidebar"><%- icon('menu','icon icon-sm') %></button>
    </div>
    <!-- Reference: one-line health state under the brand (full report: Insights · Health) -->
    <div class="side-health" id="sideHealth" title="Eight operational checks — full report in System Health & Logs">
      <span class="health-dot" id="sideHealthDot"></span><span id="sideHealthTxt">Checking…</span><span class="health-count" id="sideHealthCount">—/8</span>
    </div>
    <nav class="sb-areas" aria-label="Areas">
      <!-- v1.1 IA: five collapsible categories; merged items open their first tab (data-views family). All 25 screens reachable. -->
      <details class="sb-acc" open>
        <summary class="sb-group" data-group="overview" aria-label="Overview"><span class="g-txt">Overview</span><span class="sb-acc-chev" aria-hidden="true"><%- icon('chev-down') %></span></summary>
        <div class="sb-items">
        <button class="sb-item" data-view="home" data-lbl="Home" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('layout-dashboard') %></span><span class="lbl">Home</span></button>
        <button class="sb-item" data-views="analytics,digest" data-view="analytics" data-lbl="Analytics & Reports" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('chart') %></span><span class="lbl">Analytics & Reports</span></button>
</div>
      </details>
      <details class="sb-acc" open>
        <summary class="sb-group" data-group="publish" aria-label="Publishing & Content"><span class="g-txt">Publishing & Content</span><span class="sb-acc-chev" aria-hidden="true"><%- icon('chev-down') %></span></summary>
        <div class="sb-items">
        <button class="sb-item" data-view="newpost" data-lbl="Compose" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('pen') %></span><span class="lbl">Compose</span></button>
        <button class="sb-item" data-views="approvals,scheduled" data-view="approvals" data-lbl="Queue & Scheduled" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('inbox') %></span><span class="lbl">Queue & Scheduled</span></button>
        <button class="sb-item" data-view="bulk" data-lbl="Bulk Send" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('send') %></span><span class="lbl">Bulk Send</span></button>
        <button class="sb-item" data-view="media" data-lbl="Content Library" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('folder') %></span><span class="lbl">Content Library</span></button>
        <button class="sb-item" data-view="posts" data-lbl="History" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('history') %></span><span class="lbl">History</span></button>
</div>
      </details>
      <details class="sb-acc" open>
        <summary class="sb-group" data-group="channels" aria-label="Channels & Routing"><span class="g-txt">Channels & Routing</span><span class="sb-acc-chev" aria-hidden="true"><%- icon('chev-down') %></span></summary>
        <div class="sb-items">
        <button class="sb-item" data-views="sources,targets" data-view="sources" data-lbl="Sources & Targets" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('globe') %></span><span class="lbl">Sources & Targets</span></button>
        <button class="sb-item" data-views="routing,guardrails" data-view="routing" data-lbl="Routing Rules" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('route') %></span><span class="lbl">Routing Rules</span></button>
        <button class="sb-item" data-view="browse" data-lbl="Discover" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('search') %></span><span class="lbl">Discover</span></button>
</div>
      </details>
      <details class="sb-acc" open>
        <summary class="sb-group" data-group="audience" aria-label="Audience & Automation"><span class="g-txt">Audience & Automation</span><span class="sb-acc-chev" aria-hidden="true"><%- icon('chev-down') %></span></summary>
        <div class="sb-items">
        <button class="sb-item" data-view="whatsapp" data-lbl="WhatsApp Inbox" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('chat') %></span><span class="lbl">WhatsApp Inbox</span></button>
        <button class="sb-item" data-view="journal" data-lbl="Contacts" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('users') %></span><span class="lbl">Contacts</span></button>
        <button class="sb-item" data-views="aireply,aipilot" data-view="aireply" data-lbl="Auto-Replies & AI Pilot" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('bot') %></span><span class="lbl">Auto-Replies & AI Pilot</span></button>
</div>
      </details>
      <details class="sb-acc" open>
        <summary class="sb-group" data-group="system" aria-label="System & Workspace"><span class="g-txt">System & Workspace</span><span class="sb-acc-chev" aria-hidden="true"><%- icon('chev-down') %></span></summary>
        <div class="sb-items">
        <button class="sb-item" data-view="branding" data-lbl="Brand & Workspace" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('wand') %></span><span class="lbl">Brand & Workspace</span></button>
        <button class="sb-item" data-views="health,logs,audit" data-view="health" data-lbl="System Health & Logs" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('pulse') %></span><span class="lbl">System Health & Logs</span></button>
        <button class="sb-item" data-view="email" data-lbl="Email & Notifications" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('mail') %></span><span class="lbl">Email & Notifications</span></button>
        <button class="sb-item" data-views="settings,about" data-view="settings" data-lbl="Settings & About" role="link" tabindex="0"><span class="sb-glyph" aria-hidden="true"><%- icon('settings') %></span><span class="lbl">Settings & About</span></button>
</div>
      </details>
</nav>
    <!-- Reference: paired-identity card · labeled panic stop · workspace owner row -->
    <div class="sb-foot sidebar-bottom">
      <div class="paired-card" id="pairedCard">
        <span class="paired-indicator" id="pairedDot"></span>
        <div><strong id="pairedTitle">WhatsApp</strong><small id="pairedSub">Link from Home — one scan, never again</small></div>
      </div>
      <div class="user-row">
        <span class="avatar" id="userAvatar">RA</span>
        <div class="user-copy"><strong id="userName">Workspace owner</strong><small>Administrator</small></div>
        <button class="icon-btn" id="helpBtn" title="What does everything do? — one-line guide" aria-label="Help — what each switch does"><%- icon('help','icon icon-sm') %></button>
        <button class="icon-btn" id="themeBtn" title="Theme: dark / light / glass / auto" aria-label="Toggle theme"></button>
      </div>
    </div>
  </aside>
  <div class="sb-scrim" id="sideScrim"></div>

  <!-- ═══ MAIN ═══ -->
  <div class="main">
    <!-- Reference top bar: breadcrumb · command search · top actions (connection pill, bell, panic) -->
    <header class="topbar">
      <button class="icon-btn menu-btn" id="menuBtn" title="Menu" aria-label="Menu"><%- icon('menu') %></button>
      <div class="breadcrumb" id="breadcrumb">
        <span id="crumbGroup">COMMAND</span><b>/</b><h1 class="tb-title" id="viewTitle">Dashboard</h1>
      </div>
      <div class="tb-right top-actions">
        <span class="connection-pill" id="connPill" title="WhatsApp link state — routine deploys never ask for a new QR scan">
          <span class="health-dot" id="connDot"></span><span id="connState">Checking…</span><span class="muted">·</span><strong id="connName"><%= botName %> Primary</strong>
        </span>
        <span class="ro-chip" id="roChip" hidden>READ-ONLY</span>
        <button class="icon-btn bell-btn notification-button" id="notifBtn" title="Notifications" aria-label="Notifications">
          <%- icon('bell','icon icon-sm') %><span class="bell-badge" id="notifBadge" hidden>0</span>
        </button>
        <button class="icon-btn panic-btn panic-top" id="panicBtn" title="Panic stop — pause everything instantly (exact state is restored)" aria-label="Panic stop">
          <%- icon('shield','icon icon-sm') %><span class="panic-lbl">Panic stop</span>
        </button>
        <button class="pal-btn command-search" id="palBtn" title="Search & jump (Ctrl K)" aria-label="Open command palette">
          <%- icon('search','icon icon-xs') %><span class="lbl">Search anything…</span><kbd>Ctrl K</kbd>
        </button>
      </div>
    </header>
    <!-- Meridian 2: per-screen Recent — the last three places you were, one tap back -->
    <div class="recent-strip" id="recentStrip" hidden aria-label="Recently visited"></div>
    <div class="notif-panel" id="notifPanel" hidden role="dialog" aria-label="Notifications">
      <div class="notif-h">
        <b>Notifications</b>
        <button class="btn btn-sm btn-g" id="notifReadAll">Mark all read</button>
      </div>
      <div class="notif-list" id="notifList"></div>
    </div>

    <!-- 5E (R73): panic banner — visible on every view while the panic stop is active -->
    <div class="panic-banner" id="panicBanner" hidden role="alert">
      <%- icon('shield','icon icon-sm') %>
      <span><b>Panic stop active</b> — mirroring, queue, scheduler, auto-replies and reports are all paused.<span id="panicSince" class="muted tiny"></span></span>
      <button class="btn btn-sm" id="panicRestore">Restore previous state</button>
    </div>

    <!-- Signal Desk: no inner-tab row — every screen lives in the 8-group sidebar (§1.3) -->

    <main class="content" id="content">

      <!-- ═══ OVERVIEW · DASHBOARD ═══ -->
      <section class="view" data-view="home">
        <div id="cloudNote"></div>
        <!-- Reference home shell: eyebrow + greeting + live badge + New post -->
        <div class="page-heading">
          <div><div class="eyebrow">OVERVIEW</div><h1 id="homeGreeting">Good day, Admin.</h1><p id="homeSub">Your broadcast desk is operating normally. Here is the signal across your channels.</p></div>
          <div class="heading-actions"><span class="live-badge"><i></i> LIVE · 24/7</span><button class="btn btn-p" id="homeNewPost" data-goview="newpost"><%- icon('plus','icon icon-xs') %> New post</button></div>
        </div>
        <div class="card pausebar" id="pauseBar" data-hov>
          <div class="pb-t"><b id="pauseHead">Mirroring is running.</b><span class="muted" id="pauseSub">Every source → every target, automatically.</span></div>
          <button class="btn btn-d" id="pauseBtn"><%- icon('pause','icon icon-xs') %> <span>Pause all mirroring</span></button>
        </div>
        <div class="kpis kpi-grid" id="kpiGrid"></div>
        <!-- Signal Desk §1.3: read-only automation chips — state only, deep-link to the owner -->
        <div class="rosw-row" id="homeSwitchChips" hidden></div>
        <!-- Reference home grid: activity + queue + health + pacing + recent, all real data -->
        <div class="home-grid">
          <div class="home-col home-col-main">
            <div class="card activity-panel">
              <div class="card-h"><%- icon('chart','icon') %> Activity overview <span class="muted tiny">— post outcomes over the last 24 hours</span></div>
              <div class="card-b">
                <div class="chart-legend"><span><i class="legend-dot published"></i>Published</span><span><i class="legend-dot skipped"></i>Skipped</span><span><i class="legend-dot failed"></i>Failed</span></div>
                <div class="activity-chart" id="homeChart"><div class="chart-y" id="homeChartY"></div><div class="home-chart-svg" id="homeChartSvg"></div><div class="chart-x" id="homeChartX"></div></div>
                <div class="muted tiny" id="homeChartFoot" style="margin-top:8px"></div>
              </div>
            </div>
            <div class="card recent-panel">
              <div class="card-h"><%- icon('zap','icon') %> Recent activity <span class="muted tiny">— latest processing outcomes</span> <a class="text-link" href="#view=logs" data-goview="logs" style="margin-left:auto">Full history ↗</a></div>
              <div class="card-b"><div class="tl" id="activityFeed"></div></div>
            </div>
          </div>
          <div class="home-col home-col-side">
            <div class="card queue-panel">
              <div class="card-h"><%- icon('inbox','icon') %> Queue status <span class="muted tiny">— items that need attention</span></div>
              <div class="card-b" id="homeQueue"></div>
            </div>
            <div class="card health-panel">
              <div class="card-h"><%- icon('pulse','icon') %> System health <span class="muted tiny">— eight operational checks</span> <a class="text-link" href="#view=health" data-goview="health" style="margin-left:auto">Details ↗</a></div>
              <div class="card-b" id="homeHealth"></div>
            </div>
            <div class="card pacing-panel">
              <div class="card-h"><%- icon('gauge','icon') %> Adaptive pacing <span class="muted tiny">— delivery rate controller</span> <a class="text-link" href="#view=guardrails" data-goview="guardrails" style="margin-left:auto">Open control ↗</a></div>
              <div class="card-b" id="homePace"><div id="paceStrip" hidden></div><div id="homePaceBody"></div></div>
            </div>
          </div>
        </div>
        <div class="card qr-card" id="qrCard" hidden>
          <%- icon('chat','icon icon-xl') %>
          <h3>Link WhatsApp</h3>
          <p class="muted" id="qrDetail">Scan the QR with WhatsApp → Linked devices</p>
          <img id="qrImg" alt="WhatsApp QR code" width="280" height="280">
          <p class="muted tiny">The QR refreshes automatically — one scan is enough.</p>
        </div>
        <!-- 5J (J2): setup wizard — progress is SAVED; the card auto-hides once complete and can be re-opened from Settings -->
        <div class="card" id="setupCard" hidden>
          <div class="card-h"><%- icon('clock','icon') %> Setup wizard <span class="muted tiny" id="setupStepLbl">— progress is saved automatically</span></div>
          <div class="card-b">
            <div id="setupList"></div>
            <div class="row-actions wrap" style="margin-top:12px">
              <button class="btn btn-p btn-sm" id="setupFinish" hidden><%- icon('check','icon icon-xs') %> Mark setup complete</button>
              <button class="btn btn-g btn-sm" id="setupReopen" hidden>Reopen setup</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ CHANNELS · SOURCES ═══ -->
      <section class="view" data-view="sources" hidden>
      <div class="vtab-row" role="tablist" aria-label="Sources & Targets">
        <button class="vtab" data-go="sources" role="tab">Sources</button>
        <button class="vtab" data-go="targets" role="tab">Targets</button>
      </div>

        <div class="ph">
          <div class="ph-l"><h2>Sources</h2><div class="ph-d">Channels the bot follows — every post they make is mirrored to your targets.</div></div>
          <div class="ph-a">
            <span class="sync-meta" id="srcSync"><span id="srcSyncTime">Last synced —</span><button class="btn btn-sm btn-g" id="srcRefresh" title="Re-sync your followed channels now"><%- icon('refresh','icon icon-xs') %> Refresh</button></span>
          </div>
        </div>
        <div class="wa-gate" id="srcGate" hidden>
          <%- icon('lock','icon') %>
          <div><b>Sources unlock once WhatsApp is linked.</b><span class="muted tiny">Scan the QR on the Home screen — it takes about a minute, and you only ever do it once.</span></div>
          <button class="btn btn-p btn-sm" data-wagate>Link WhatsApp</button>
        </div>
        <div class="card" data-hov>
          <div class="card-h">Add source channel(s) <%- icon('plus','icon') %></div>
          <div class="card-b">
            <div class="row-form">
              <input class="in" id="srcInput" placeholder="Paste an invite link (whatsapp.com/channel/…)">
              <button class="btn btn-p" id="srcAdd"><%- icon('plus','icon icon-xs') %> Add</button>
            </div>
            <div id="srcPicker" style="margin-top:12px"></div>
            <p class="muted tiny f-help" style="margin-top:12px">Photos, videos and files in posts are mirrored too. New followed channels are added automatically while Auto-monitor is on.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-h">
            Sources <span class="pill num" id="srcCount">0</span>
            <span class="sw-inline" style="margin-left:auto"><span>Auto-monitor new follows</span>
              <label class="sw"><input type="checkbox" id="automonitor" title="Channels you start following on your phone are added here automatically"><i></i></label>
            </span>
          </div>
          <div class="card-b">
            <div class="tw"><table class="t" id="srcTable"><thead><tr><th>Name</th><th class="mono">Channel ID</th><th>Status</th><th title="WhatsApp subscriber count — best-effort daily snapshot (updated at most once a day per channel)">Subscribers</th><th>Added</th><th></th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">RSS / Atom feeds <%- icon('radio','icon') %></div>
          <div class="card-b">
            <p class="muted tiny f-help">Follow a website's feed instead of a WhatsApp channel. New items are fetched every 15 minutes and go through the <b>same pipeline</b> — dedupe, blocklist, rate guard, keyword rules and your approval queue. Nothing is posted until the pipeline says so.</p>
            <div class="row-form wrap" style="margin-top:12px">
              <input class="in" id="rssName" placeholder="Feed name (e.g. Dawn Business)" style="flex:1;min-width:180px">
              <input class="in" id="rssUrl" placeholder="Feed URL (https://…/rss or /feed)" style="flex:2;min-width:240px">
              <button class="btn" id="rssTest" style="flex:none"><%- icon('zap','icon icon-xs') %> Test feed</button>
              <button class="btn btn-p" id="rssAdd" style="flex:none"><%- icon('plus','icon icon-xs') %> Add feed</button>
            </div>
            <div id="rssTestResult" class="muted tiny" style="margin-top:10px"></div>
          </div>
        </div>
      </section>

      <!-- ═══ CHANNELS · BROWSE ═══ -->
      <section class="view" data-view="browse" hidden>
        <div class="ph">
          <div class="ph-l"><h2>Discover</h2><div class="ph-d">Discover channels you don't follow yet — pick a category and country, follow any you like, then add them to Sources to mirror their posts.</div></div>
          <div class="ph-a">
            <span class="sync-meta" id="brwSync"><span id="brwSyncTime">Last synced —</span><button class="btn btn-sm btn-g" id="brwRefresh" title="Re-load the channel list"><%- icon('refresh','icon icon-xs') %> Refresh</button></span>
          </div>
        </div>
        <div class="card" data-hov>
          <div class="card-h">Add any channel by link <%- icon('globe','icon') %></div>
          <div class="card-b">
            <div class="row-form">
              <input class="in" id="brwLink" placeholder="Paste a channel link (whatsapp.com/channel/… or chat.whatsapp.com/…)" style="flex:2;min-width:240px">
              <button class="btn btn-p" id="brwLinkFollow" style="flex:none"><%- icon('plus','icon icon-xs') %> Follow</button>
            </div>
            <p class="muted tiny f-help" style="margin-top:10px">Every real channel link works. The list below is a directory of <b id="brwFootCount">…</b> real channels — each one verified against WhatsApp's own channel pages. WhatsApp does not expose its "recommended channels" feed to linked accounts, so this is a curated directory rather than live recommendations. Following here adds the channel to your Sources at once; channels you follow on your phone also land in Sources automatically.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-h">
            Channels <span class="pill num" id="brwCount">0</span>
            <span class="muted tiny" id="brwFollowed" style="margin-left:auto"></span>
          </div>
          <div class="card-b">
            <div class="brw-filters" id="brwCats" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px"></div>
            <div class="row-form wrap" style="margin-bottom:12px">
              <select class="in" id="brwCountry" style="max-width:220px"></select>
              <input class="in" id="brwSearch" placeholder="Search the list by name…" style="flex:1;min-width:180px">
            </div>
            <div id="brwList"></div>
            <div id="brwMore" class="muted tiny brw-more" hidden><div class="skel skel-line" style="width:140px;height:10px;margin-bottom:6px"></div>Loading more…</div>
            <div id="brwEnd" class="muted tiny f-help" style="margin-top:12px" hidden>That's the whole directory. Paste any channel link in the box above to follow one that isn't listed — or follow channels on your phone and they'll land in Sources automatically.</div>
          </div>
        </div>
      </section>

      <!-- ═══ CHANNELS · TARGETS ═══ -->
      <section class="view" data-view="targets" hidden>
      <div class="vtab-row" role="tablist" aria-label="Sources & Targets">
        <button class="vtab" data-go="sources" role="tab">Sources</button>
        <button class="vtab" data-go="targets" role="tab">Targets</button>
      </div>

        <div class="ph">
          <div class="ph-l"><h2>Targets</h2><div class="ph-d">Your channels — everything the bot publishes goes here.</div></div>
          <div class="ph-a">
            <span class="sync-meta" id="tgtSync"><span id="tgtSyncTime">Last synced —</span><button class="btn btn-sm btn-g" id="tgtRefresh" title="Re-sync your channels now"><%- icon('refresh','icon icon-xs') %> Refresh</button></span>
          </div>
        </div>
        <div class="wa-gate" id="tgtGate" hidden>
          <%- icon('lock','icon') %>
          <div><b>Targets unlock once WhatsApp is linked.</b><span class="muted tiny">Scan the QR on the Home screen — it takes about a minute, and you only ever do it once.</span></div>
          <button class="btn btn-p btn-sm" data-wagate>Link WhatsApp</button>
        </div>
        <div class="card" data-hov>
          <div class="card-h">Add target channel(s) <%- icon('plus','icon') %></div>
          <div class="card-b">
            <div class="row-form">
              <input class="in" id="tgtInput" placeholder="Paste an invite link (whatsapp.com/channel/…)">
              <button class="btn btn-p" id="tgtAdd"><%- icon('plus','icon icon-xs') %> Add</button>
            </div>
            <div id="tgtPicker" style="margin-top:12px"></div>
            <p class="muted tiny f-help" style="margin-top:12px">Only channels where you are owner/admin can be posted to. Per-source mapping (Routing) can override this.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Targets <span class="pill num" id="tgtCount">0</span></div>
          <div class="card-b">
            <div class="tw"><table class="t" id="tgtTable"><thead><tr><th>Name</th><th class="mono">Channel ID</th><th>Status</th><th>Added</th><th></th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
      </section>

      <!-- ═══ CHANNELS · ROUTING ═══ -->
      <section class="view" data-view="routing" hidden>
      <div class="vtab-row" role="tablist" aria-label="Routing Rules">
        <button class="vtab" data-go="routing" role="tab">Routing</button>
        <button class="vtab" data-go="guardrails" role="tab">Rules</button>
      </div>

        <div class="ph">
          <div class="ph-l"><h2>Routing</h2><div class="ph-d">Where posts go — per-target include / exclude / media filters.</div></div>
        </div>
        <!-- 5J (J1): Pipeline Inspector — dry-run any text through every stage, nothing is sent -->
        <div class="card" data-hov>
          <div class="card-h">Pipeline inspector <%- icon('search','icon') %> <span class="muted tiny">— dry-run, zero side effects</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">Paste any text and the bot replays the EXACT pipeline order on it: gates (blocklist, dedupe, rate guard, source rules) are checked but nothing is marked, queued or sent; AI steps are reported, not run (no AI cost). Watch the text change stage by stage.</p>
            <div class="row-form" style="margin-top:12px">
              <select class="in" id="piSource" style="flex:none;max-width:240px" title="Optional — source-specific rules (hours, keywords, daily cap) are checked for this source">
                <option value="">No source (global gates only)</option>
              </select>
              <button class="btn btn-p" id="piRun"><%- icon('play','icon icon-xs') %> Run dry-run</button>
            </div>
            <div class="field" style="margin-top:10px"><textarea class="in" id="piText" rows="4" placeholder="Paste the post text you want to inspect…"></textarea></div>
            <div id="piOut" hidden>
              <div class="pi-counters" id="piCounters"></div>
              <div class="pi-gates" id="piGates"></div>
              <div class="pi-stages" id="piStages"></div>
              <div class="muted tiny" id="piRouting" style="margin-top:8px"></div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Smart routing <%- icon('route','icon') %></div>
          <div class="card-b"><div class="sw-grid" id="swRouting"></div></div>
        </div>
        <div class="card" data-hov>
          <div class="card-h">Routing matrix <%- icon('grid','icon') %> <span class="muted tiny">— every source × every target, saved as you click</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">Explicit cells override the mapping: tick a cell to force-publish that source to that target, untick to stop it. Sources without a mapping default to ALL targets. Turn the <b>Routing matrix</b> switch above ON to apply it (OFF = current behavior).</p>
            <div id="matrixBox" style="margin-top:12px"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Routing rules</div>
          <div class="card-b">
            <p class="muted tiny f-help">Per-target filters: only matching posts are published to that target. Leave everything empty to allow all.</p>
            <div id="routingList" style="margin-top:12px"></div>
            <div class="row-actions"><button class="btn btn-p" id="routingSave">Save routing rules</button></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Outgoing webhooks <%- icon('zap','icon') %></div>
          <div class="card-b">
            <p class="muted tiny f-help">Send a small JSON notification to your own HTTPS endpoint when something happens. <b>Off by default</b> — nothing is sent until you add a webhook. Delivery tries up to 3 times (2 s, then 10 s) and never slows or breaks the pipeline. The “Last result” column shows exactly what happened.</p>
            <div id="hookList" style="margin-top:12px"></div>
            <h3 style="margin-top:16px;font-size:var(--t14);font-weight:600">Add a webhook</h3>
            <div class="row-form wrap" style="margin-top:10px">
              <input class="in" id="hookName" placeholder="Name (e.g. Zapier)" style="flex:1;min-width:150px">
              <input class="in" id="hookUrl" placeholder="https://your-endpoint.example/hook" style="flex:2;min-width:240px">
              <button class="btn btn-p" id="hookAdd" style="flex:none"><%- icon('plus','icon icon-xs') %> Add</button>
            </div>
            <div id="hookEventPick" class="row-form wrap" style="margin-top:10px"></div>
          </div>
        </div>
      </section>

      <!-- ═══ CONTENT · COMPOSER ═══ -->
      <section class="view" data-view="newpost" hidden>
        <div class="ph">
          <div class="ph-l"><h2>Compose</h2><div class="ph-d">Write a post and publish it to your channels — optionally cleaned up by AI first.</div></div>
        </div>
        <!-- 5H (R88): “Plan my week” → drafts in the Approval Queue -->
        <div class="card">
          <div class="card-h">Plan my week <%- icon('calendar','icon') %> <span class="muted tiny">— AI drafts 7 days of posts for your approval</span></div>
          <div class="card-b">
            <p class="muted tiny f-help">The AI looks at your recent posts and drafts the next 7 days (one per day, varied in tone). Nothing is published — every draft lands in the <b>Approval Queue</b> for you to edit, approve or reject. Uses your AI key (Settings → AI).</p>
            <div class="row-actions" style="margin-top:12px"><button class="btn btn-p" id="planWeekBtn"><%- icon('sparkles','icon icon-xs') %> Plan my week</button><span class="muted tiny" id="planWeekMsg" style="align-self:center"></span></div>
          </div>
        </div>
        <div class="card" data-hov>
          <div class="card-h">New post <%- icon('pen','icon') %></div>
          <div class="card-b">
            <!-- 5B R49: formatting toolbar (WhatsApp markdown: *bold* _italic_ ~strike~ |mono|) -->
            <div class="cbar" role="toolbar" aria-label="Formatting">
              <button type="button" class="cb" data-fmt="bold" title="Bold — wraps the selection in *asterisks*"><b>B</b></button>
              <button type="button" class="cb" data-fmt="italic" title="Italic — wraps the selection in _underscores_"><i>I</i></button>
              <button type="button" class="cb" data-fmt="strike" title="Strikethrough — wraps the selection in ~tildes~"><s>S</s></button>
              <button type="button" class="cb" data-fmt="mono" title="Monospace — wraps the selection in |pipes|">M</button>
              <button type="button" class="cb" data-fmt="clear" title="Remove all * _ ~ | markup from the post">T</button>
              <span class="cbar-sp"></span>
              <span class="muted tiny" id="composeCount">0 chars</span>
            </div>
            <div class="comp2">
              <div class="field"><textarea class="in" id="composeText" rows="9" placeholder="Write your post… (line breaks are kept)"></textarea></div>
              <div class="cprev-wrap"><div class="cprev-h muted tiny">Preview — how WhatsApp renders it</div><div class="cprev" id="composePreview"></div></div>
            </div>
            <!-- 5B R50 + 5C R55: AI buttons + prompt library -->
            <div class="row-actions wrap" style="margin-top:12px">
              <span class="muted tiny" style="width:100%">Rewrite — AI replaces the box (keeps a one-step Undo in the toast):</span>
              <button class="btn btn-g" data-aiact="improve">Improve</button>
              <button class="btn btn-g" data-aiact="shorten">Shorten</button>
              <button class="btn btn-g" data-aiact="formal">Formal</button>
              <button class="btn btn-g" data-aiact="translate">Translate</button>
              <button class="btn btn-g" data-aiact="emojify">Add emoji</button>
              <select class="in" id="libPromptPick" style="flex:1;min-width:200px" title="Run a prompt from your Prompt Library on this text">
                <option value="">Run a library prompt…</option>
              </select>
              <button class="btn btn-g" id="libPromptGo">Apply</button>
              <!-- Signal Desk §1.3: one-off transforms stay one-off; the always-on
                   switches behind them are read-only here and deep-link to their home -->
              <span class="muted tiny" style="width:100%">Always-on (read-only here):</span>
              <span class="rosw-row" id="composeSwitchChips" hidden style="flex:1;min-width:200px"></span>
            </div>
            <!-- 5I (I4): announcement card — this text as a branded 1080×1080 card (PNG/SVG download) -->
            <div class="row-actions wrap" style="margin-top:12px">
              <button class="btn" id="composeCardBtn"><%- icon('image','icon icon-xs') %> Make a card</button>
              <span class="muted tiny">Turn this text into a branded 1080×1080 announcement card — download PNG or SVG. Nothing is attached to the post automatically.</span>
            </div>
            <!-- 5B R51: snippets with {placeholders} -->
            <div class="row-form wrap" style="margin-top:12px" id="composeSnippetRow">
              <select class="in" id="snippetPick" title="Insert a saved snippet (braces like {name} become fill-in fields)">
                <option value="">Insert a snippet…</option>
              </select>
              <button class="btn btn-g" id="snippetInsert">Insert</button>
              <button class="btn btn-g" id="snippetManage">Manage snippets</button>
            </div>
            <div class="row-form wrap" style="margin-top:12px">
              <input class="in" id="composeImage" placeholder="Optional image URL (https://…)">
              <input type="file" id="composeUpload" accept="image/*" title="…or upload a photo (max 5 MB)">
              <button class="btn btn-g" id="composeUploadClear" hidden>Remove photo</button>
              <label class="sw-inline"><span>AI clean-up first</span><label class="sw"><input type="checkbox" id="composeBeautify"><i></i></label></label>
            </div>
            <div class="field" style="margin-top:12px"><label>Publish to</label><div id="composePicker"></div></div>
            <div class="row-actions wrap">
              <button class="btn btn-p btn-lg" id="composeSend"><%- icon('send','icon icon-xs') %> Publish post</button>
              <!-- 5B R52: test send to your own number -->
              <input class="in" id="composeTestPhone" placeholder="Your number (92300…)" style="flex:none;width:150px" title="Send a copy of this post to your own number to check the formatting">
              <button class="btn btn-g" id="composeTestSend">Test send to me</button>
              <span class="muted tiny" id="composeResult"></span>
            </div>
          </div>
        </div>
        <!-- 5B R49: drafts -->
        <div class="card" style="margin-top:16px">
          <div class="card-h">Drafts <span class="muted tiny">— saved on this device's bot</span> <button class="btn btn-g btn-sm" id="draftSave" style="margin-left:auto">Save current text as draft</button></div>
          <div class="card-b"><div id="draftList"><div class="muted tiny">No drafts yet — write something and press "Save current text as draft".</div></div></div>
        </div>
      </section>

      <!-- ═══ CONTENT · SCHEDULED ═══ -->
      <section class="view" data-view="scheduled" hidden>
      <div class="vtab-row" role="tablist" aria-label="Queue & Scheduled">
        <button class="vtab" data-go="approvals" role="tab">Queue</button>
        <button class="vtab" data-go="scheduled" role="tab">Scheduled</button>
      </div>

        <div class="ph">
          <div class="ph-l"><h2>Scheduled</h2><div class="ph-d">Posts that go out at the time you pick. Missed while offline — published on wake.</div></div>
          <div class="ph-a">
            <!-- Meridian 2: the old Calendar screen lives here as a List / Calendar toggle -->
            <div class="tabs" id="schedModeTabs">
              <button class="tab on" data-schedmode="list">List</button>
              <button class="tab" data-schedmode="cal">Calendar</button>
            </div>
          </div>
        </div>
        <div id="schedListMode">
        <div class="card">
          <div class="card-h">Schedule a post <span class="muted tiny" style="margin-left:8px">— the Scheduler switch lives in Automate · Pilot (one home)</span></div>
          <div class="card-b">
            <div class="row-form wrap">
              <select class="in" id="schedTarget" title="Target channel"></select>
              <input class="in" id="schedName" placeholder="Name (optional)">
              <input class="in" id="schedAt" type="datetime-local" title="When to publish (Pakistan time, UTC+5)">
              <select class="in" id="schedRepeat" style="flex:none;width:auto" title="How often">
                <option value="once">Once</option><option value="daily">Daily</option><option value="weekly">Weekly</option>
                <option value="weekdays">Specific weekdays</option><option value="interval">Every N minutes</option>
              </select>
            </div>
            <div id="schedWeekdayBox" hidden style="margin-top:12px">
              <div class="row-form wrap" id="schedWeekdays">
                <label class="chip-opt"><input type="checkbox" value="1" checked><span>Mon</span></label>
                <label class="chip-opt"><input type="checkbox" value="2" checked><span>Tue</span></label>
                <label class="chip-opt"><input type="checkbox" value="3" checked><span>Wed</span></label>
                <label class="chip-opt"><input type="checkbox" value="4" checked><span>Thu</span></label>
                <label class="chip-opt"><input type="checkbox" value="5" checked><span>Fri</span></label>
                <label class="chip-opt"><input type="checkbox" value="6"><span>Sat</span></label>
                <label class="chip-opt"><input type="checkbox" value="7"><span>Sun</span></label>
              </div>
            </div>
            <div id="schedIntervalBox" hidden class="row-form" style="margin-top:12px">
              <label class="sw-inline"><span>Every</span><input class="in" id="schedIntervalMin" type="number" min="1" max="10080" value="30" style="flex:none;width:90px" title="Minutes between runs"></label>
              <span class="muted tiny">minutes (60 = hourly, 1440 = daily)</span>
            </div>
            <div class="row-form wrap" style="margin-top:12px">
              <select class="in" id="schedTemplate" style="flex:none" title="Optionally run the text through a post template before publishing">
                <option value="">No template — publish as written</option>
              </select>
              <span class="muted tiny" id="schedTzNote">Times are Pakistan Standard Time (UTC+5), 24 h.</span>
            </div>
            <div class="field" style="margin-top:12px"><textarea class="in" id="schedText" rows="3" placeholder="The post text to publish…"></textarea></div>
            <div class="row-actions"><button class="btn btn-p" id="schedAdd"><%- icon('calendar-clock','icon icon-xs') %> Schedule</button></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Scheduled posts</div>
          <div class="card-b">
            <div class="tw"><table class="t" id="schedTable"><thead><tr><th>Post</th><th>Target</th><th>Next run (PKT)</th><th>Repeat</th><th class="num">Sent</th><th></th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">When things run this month <%- icon('calendar','icon') %>
            <div class="row-form" style="margin-left:auto">
              <button class="btn btn-sm" id="calPrev">‹</button>
              <span class="muted tiny" id="calMonth" style="min-width:110px;text-align:center"></span>
              <button class="btn btn-sm" id="calNext">›</button>
            </div>
          </div>
          <div class="card-b"><div id="calGrid" class="cal-grid"></div><p class="muted tiny f-help" style="margin-top:10px">A dot on a day = at least one scheduled post runs that day. Weekday/interval repeats are expanded for the whole month.</p></div>
        </div>
        </div><!-- /schedListMode -->
        <!-- Meridian 2: Calendar mode — the old Content Calendar screen, regrouped under Scheduled -->
        <div id="schedCalMode" hidden>
          <div class="card">
            <div class="card-h">
              <span id="fcalTitle">—</span>
              <span style="margin-left:auto;display:inline-flex;align-items:center;gap:10px">
                <span class="muted tiny" style="display:inline-flex;align-items:center;gap:8px">
                  <span class="cal-dot cal-published"></span> published ·
                  <span class="cal-dot cal-scheduled"></span> scheduled ·
                  <span class="cal-dot cal-draft"></span> draft ·
                  <span class="cal-dot cal-plan"></span> plan ·
                  <span class="cal-dot cal-evergreen"></span> evergreen
                </span>
              </span>
            </div>
            <div class="card-b">
              <div class="row-form wrap" style="margin-bottom:12px">
                <div class="tabs" id="fcalTabs">
                  <button class="tab on" data-cal="month">Month</button>
                  <button class="tab" data-cal="week">Week</button>
                </div>
                <button class="btn btn-sm" id="fcalPrev" title="Previous month"><%- icon('chev-left','icon icon-xs') %> Previous</button>
                <button class="btn btn-sm" id="fcalToday">Today</button>
                <button class="btn btn-sm" id="fcalNext" title="Next month">Next <%- icon('chev-right','icon icon-xs') %></button>
              </div>
              <div class="cal-head" id="fcalHead"></div>
              <div class="cal-grid" id="fcalGrid"></div>
              <div id="fcalWeek" hidden></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ MEDIA LIBRARY (J2 · I2 — Phase 5J/5I) ═══ -->
      <section class="view" data-view="media" hidden>
        <div class="ph"><div class="ph-l"><h2>Library</h2><div class="ph-d">Everything you keep: the media the bot has stored, your post-format templates, and the announcement card maker.</div></div></div>
        <div class="card">
          <div class="card-b">
            <div class="filterbar" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center">
              <select id="mlKind" class="in" style="max-width:150px" title="Filter by media type">
                <option value="">All types</option>
                <option value="image">Images</option>
                <option value="video">Videos</option>
                <option value="document">Documents</option>
                <option value="audio">Audio</option>
              </select>
              <input id="mlSearch" class="in" style="min-width:180px" type="search" placeholder="Search name or number…" title="Search by file name or number">
              <select id="mlSession" class="in" style="max-width:150px" title="Which number (chat media only)">
                <option value="main">Main number</option>
              </select>
              <button class="btn btn-ghost" id="mlRefresh" type="button" title="Reload the library">↻ Refresh</button>
              <span class="mut" id="mlCount" style="margin-left:auto;font-size:12px"></span>
            </div>
            <div id="mlGrid" class="ml-grid"></div>
            <div id="mlEmpty" class="mut" style="display:none;padding:28px;text-align:center">No media stored yet. Everything you save or queue with media shows up here.</div>
          </div>
        </div>
      
        <!-- Meridian 2: announcement cards — one home for the switch + the maker tool -->
        <div class="card">
          <div class="card-h">Announcement cards <%- icon('image','icon') %></div>
          <div class="card-b">
            <div class="sw-grid" id="swLibrary"></div>
            <p class="muted tiny f-help" style="margin-top:10px">Make a branded 1080×1080 PNG card (with SVG source) from any post text — from Compose’s “Make a card” button or here. Never attached to a post automatically.</p>
            <div class="row-actions" style="margin-top:10px"><button class="btn" id="libCardGo"><%- icon('image','icon icon-xs') %> Make a card in Compose</button></div>
          </div>
        </div>
        <!-- Templates (regrouped into Library) -->
        <div class="card">
          <div class="card-h">Post format <span class="pill" id="tplModeStatus"></span></div>
          <div class="card-b">
            <p class="muted tiny f-help">Every post's text can be rewritten into a format — pick one, rotate through a pool, or build your own. Images are never touched.</p>
            <div class="tpl-modes" id="tplModes">
              <label class="tpl-mode"><input type="radio" name="tplMode" value="off"><span><b>Off</b><em>posts go out as-is</em></span></label>
              <label class="tpl-mode"><input type="radio" name="tplMode" value="single"><span><b>Fixed</b><em>always this template</em></span></label>
              <label class="tpl-mode"><input type="radio" name="tplMode" value="rotate"><span><b>Rotate</b><em>next in the pool, every post</em></span></label>
              <label class="tpl-mode"><input type="radio" name="tplMode" value="shuffle"><span><b>Shuffle</b><em>random from the pool</em></span></label>
            </div>
            <p class="f-help" id="tplPoolHint" hidden style="margin-top:12px">Tick the templates that may be used in Rotate / Shuffle below. Nothing ticked = the full set is used.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-h">The 20 ready-made formats <span class="muted tiny">— “Use fixed” per row · tick for the pool</span></div>
          <div class="card-b"><div id="tplGrid" class="tpl-grid"></div></div>
        </div>
        <div class="card">
          <div class="card-h">Live preview <span class="pill" id="tplPreviewUsed"></span></div>
          <div class="card-b">
            <div class="wa-bubble-wrap"><div class="wa-bubble" dir="auto" id="tplBubble">…</div></div>
            <p class="muted tiny f-help">Exactly how the sample post will look on WhatsApp — right-to-left text (Urdu/Arabic) is supported.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Your custom template <span class="muted tiny">— three zones, or one raw box</span></div>
          <div class="card-b">
            <div class="tabs" id="tplCustomTabs">
              <button class="tab on" data-t="zones">Zones</button>
              <button class="tab" data-t="raw">Raw</button>
              <button class="tab" data-t="history">Saved <span class="muted" id="tplHistCount"></span></button>
            </div>
            <div id="tplZones">
              <div class="field"><label>Header zone <span class="muted tiny">— above the post · overrides the global header when set</span></label><textarea class="in" id="tplZoneHeader" rows="2" placeholder="e.g. ✦ {source} · {date} ✦"></textarea></div>
              <div class="field" style="margin-top:12px"><label>Body zone <span class="muted tiny">— the post text · must contain {text}</span></label><textarea class="in" id="tplZoneBody" rows="4" placeholder="e.g. {title}&#10;&#10;{text}"></textarea></div>
              <div class="field" style="margin-top:12px"><label>Footer zone <span class="muted tiny">— below the post · overrides the global footer when set</span></label><textarea class="in" id="tplZoneFooter" rows="2" placeholder="e.g. Follow for daily updates"></textarea></div>
              <div class="ph-chips" id="phChips" title="Click a chip to insert it at the cursor"></div>
              <div class="row-actions"><button class="btn btn-p" id="tplCustomSave"><%- icon('save','icon icon-xs') %> Save custom template</button><span class="muted tiny" id="tplCustomSaved"></span></div>
            </div>
            <div id="tplRaw" hidden>
              <div class="field"><label>Raw template <span class="muted tiny">— one box, old style · {{POST}} and {{DATE}} still work</span></label><textarea class="in" id="tplRawBody" rows="5" placeholder="e.g. ✨ {{POST}} ✨"></textarea></div>
              <div class="row-actions"><button class="btn btn-p" id="tplRawSave">Save raw template</button></div>
            </div>
            <div id="tplHist" hidden>
              <p class="muted tiny f-help">Your last 5 custom saves — press Restore to bring one back.</p>
              <div id="tplHistList" style="margin-top:12px"></div>
            </div>
            <div class="field" style="margin-top:16px">
              <label>AI style for this template <span class="muted tiny">— in Fixed mode the AI rewrites each post in this style before the template wraps it</span></label>
              <input class="in" id="tplStyleInput" placeholder="e.g. punchy, max two lines, keep the Urdu words">
              <div class="f-help">Applies to: <b id="tplStyleTarget">—</b> · needs the AI Beautify switch + a saved AI key.</div>
              <div class="row-actions"><button class="btn" id="tplStyleSave">Save style</button></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ 5J (J4) · BRANDING STUDIO ═══ -->
      <section class="view" data-view="branding" hidden>
        <div class="ph"><div class="ph-l"><h2>Brand</h2><div class="ph-d">Your brand on every post and card: the formatting switches, the header/footer, the AI rewrite instruction and the card colors.</div></div></div>
        <div class="card">
          <div class="card-h">Brand switches <%- icon('wand','icon') %></div>
          <div class="card-b">
            <p class="muted tiny f-help">How every post's text is shaped before it goes out. Cleanup (link stripping, dividers, find→replace) is always on — these switches add the AI and formatting layers. All off by default.</p>
            <div class="sw-grid" id="swBrand" style="margin-top:12px"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h">Hashtag frequency — your own posts <span class="muted tiny">local, no AI</span></div>
