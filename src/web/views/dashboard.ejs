              <div class="row-actions" style="padding:4px 12px 8px">
                <button class="ww-pill" id="waContactsCsv" title="Download all contacts as CSV">CSV ↓</button>
                <button class="ww-pill" id="waContactsDupes" title="Find duplicate names / numbers">Find dupes</button>
              </div>
              <div class="wa-chats" id="waContactsList"></div>
            </div>
            <div class="wa-chats" id="waChatList"></div>
          </div>
          <div class="wa-pane">
            <div class="wa-header" id="waHeader"><span class="muted">Pick a chat</span></div>
            <div class="wa-hbar" id="waHBar" hidden></div>
            <div class="wa-body" id="waMsgs"></div>
            <div class="wa-foot">
              <div class="ww-composer">
                <button class="ww-ic" id="waQuickBtn" title="Quick replies" aria-label="Quick replies">⚡</button>
                <button class="ww-ic" id="waEmojiBtn" title="Emoji" aria-label="Emoji">🙂</button>
                <button class="ww-ic" id="waAttachBtn" title="Attach" aria-label="Attach">📎</button>
                <input id="waSendInput" placeholder="Type a message" autocomplete="off" aria-label="Message text">
                <button class="ww-send" id="waSendBtn" title="Send" aria-label="Send">➤</button>
