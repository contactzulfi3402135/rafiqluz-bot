<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0B0F14">
<title><%= botName %> · Connect a number</title>
<link rel="icon" href="/pwa/icon-192.png">
<style>
/* ═══ Raqifluz — v12 Obsidian · link a number ═══ */
@font-face { font-family: 'Inter'; src: url('/fonts/inter-latin.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
@font-face { font-family: 'NotoSansArabic'; src: url('/fonts/noto-sans-arabic-latin.woff2') format('woff2'); font-display: swap; }
:root{
  --bg:#05090f; --panel:#0d141d; --panel-2:#111a25; --line:#1e2c3a; --line-2:#2c3f52;
  --text:#f2f7fb; --text-2:#a9bccd; --text-3:#6b8093;
  --ok:#10b981; --ok-hot:#34d399; --gold:#f5b54a; --danger:#ef4444;
  --grad:linear-gradient(135deg,#6ee7b7 0%,#10b981 45%,#059669 100%);
  --ease:cubic-bezier(.16,1,.3,1);
}
*{box-sizing:border-box;margin:0;padding:0}
::selection{background:rgba(16,185,129,.35)}
:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(16,185,129,.35),0 0 0 1.5px var(--ok);border-radius:12px}
body{
  font-family:'Inter','NotoSansArabic',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  background:var(--bg);color:var(--text);min-height:100vh;min-height:100dvh;
  -webkit-font-smoothing:antialiased;display:flex;flex-direction:column;
}
.backdrop{position:fixed;inset:0;z-index:-1;background:url('/brand/aurora.jpg') center 28% / cover no-repeat;opacity:.9}
body::after{content:"";position:fixed;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(5,9,15,.78) 0%,rgba(5,9,15,.55) 40%,rgba(5,9,15,.92) 100%)}

/* ── Top bar ─────────────────────────────────────────────────────────── */
.top{display:flex;align-items:center;gap:13px;padding:16px 26px;border-bottom:1px solid rgba(110,231,183,.15);backdrop-filter:blur(14px);background:rgba(5,9,15,.55)}
.top .logo{width:38px;height:38px;border-radius:11px;background:var(--grad);display:grid;place-items:center;box-shadow:0 0 18px rgba(16,185,129,.5),inset 0 1px 0 rgba(255,255,255,.5);color:#04130d;font-weight:900;font-size:19px}
.top b{font-size:15px;letter-spacing:.02em}
.top small{display:block;color:var(--text-3);font-size:10px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
.top .ver{margin-left:auto;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:#8fd6b4;border:1px solid rgba(110,231,183,.3);padding:6px 12px;border-radius:999px;background:rgba(16,185,129,.08)}
.top a.back{color:var(--text-2);text-decoration:none;font-size:12px;border:1px solid var(--line-2);padding:9px 14px;border-radius:10px;transition:color .2s,border-color .2s}
.top a.back:hover{color:var(--ok-hot);border-color:var(--ok)}

/* ── Card ────────────────────────────────────────────────────────────── */
.wrap{flex:1;display:grid;place-items:center;padding:34px 18px 60px}
.card{width:min(600px,100%);background:rgba(13,20,29,.82);backdrop-filter:blur(22px) saturate(1.25);-webkit-backdrop-filter:blur(22px) saturate(1.25);border:1px solid var(--line-2);border-radius:22px;padding:28px;box-shadow:0 40px 90px -30px rgba(0,0,0,.75);animation:cardIn .7s var(--ease) both}
@keyframes cardIn{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:none}}
.kicker{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--ok-hot);font-weight:800;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.kicker::before{content:"";width:24px;height:1px;background:var(--ok-hot)}
h1{font-size:24px;letter-spacing:-0.025em;font-weight:800}
.sub{color:var(--text-2);font-size:12.5px;margin-top:6px;line-height:1.55}

.tabs{display:flex;gap:8px;margin:20px 0 18px;background:var(--panel-2);padding:6px;border-radius:13px;border:1px solid var(--line)}
.tab{flex:1;text-align:center;padding:11px 8px;border-radius:9px;cursor:pointer;color:var(--text-2);font-size:13px;font-weight:700;user-select:none;transition:all .22s var(--ease);border:1px solid transparent}
.tab:hover{color:var(--text)}
.tab.active{background:var(--grad);color:#04130d;box-shadow:0 6px 16px -6px rgba(16,185,129,.55),inset 0 1px 0 rgba(255,255,255,.5)}

ol{margin:0 0 18px;padding-left:22px;color:var(--text-2);font-size:13px;line-height:1.9}
ol b{color:var(--text)}

.btn{height:48px;border:0;border-radius:13px;font-size:14.5px;font-weight:800;cursor:pointer;width:100%;background:var(--grad);color:#04130d;font-family:inherit;box-shadow:0 8px 24px -8px rgba(16,185,129,.55),inset 0 1px 0 rgba(255,255,255,.5);position:relative;overflow:hidden;transition:transform .18s var(--ease),filter .18s;display:inline-flex;align-items:center;justify-content:center;gap:9px}
.btn::before{content:"";position:absolute;top:-60%;bottom:-60%;width:46px;left:-80px;background:linear-gradient(105deg,transparent,rgba(255,255,255,.8),transparent);transform:skewX(-22deg);transition:left .8s var(--ease)}
.btn:hover{filter:brightness(1.07);transform:translateY(-1px)}
.btn:hover::before{left:calc(100% + 80px)}
.btn:active{transform:scale(.985)}
.btn:disabled{opacity:.55;cursor:default;transform:none}
.btn.ghost{background:transparent;border:1px solid var(--line-2);color:var(--text);box-shadow:none;font-weight:650;height:42px}
.btn.ghost:hover{border-color:var(--ok);color:var(--ok-hot)}

.qrbox{margin:18px auto 6px;width:296px;height:296px;background:#fff;border-radius:18px;display:grid;place-items:center;position:relative;overflow:hidden;box-shadow:0 0 0 1px rgba(110,231,183,.5),0 0 60px rgba(16,185,129,.25)}
.qrbox img{width:276px;height:276px;image-rendering:pixelated}
.qrbox .ph{color:#54656f;font-size:13px;text-align:center;padding:0 24px;line-height:1.6}
.qrbox .spin{position:absolute;inset:0;display:grid;place-items:center;background:rgba(255,255,255,.94);color:#3c4b57;font-size:13px;border-radius:18px;padding:24px;text-align:center;line-height:1.6}
.hint{color:var(--text-3);font-size:11.5px;text-align:center;line-height:1.65;margin-top:12px}
.ok{background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.5);color:#bbf7d0;border-radius:13px;padding:14px 16px;font-size:13.5px;line-height:1.65;margin-top:16px}
.err{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.45);color:#fecaca;border-radius:13px;padding:12px 15px;font-size:13px;margin-top:16px;display:none;line-height:1.55}

input[type=text]{width:100%;height:50px;padding:0 16px;border-radius:12px;border:1px solid var(--line-2);background:var(--panel-2);color:var(--text);font-size:16px;margin-bottom:12px;letter-spacing:.06em;font-variant-numeric:tabular-nums;transition:border-color .18s,box-shadow .22s}
input[type=text]:focus{outline:none;border-color:var(--ok);box-shadow:0 0 0 3px rgba(16,185,129,.22)}
.codebox{margin:18px auto 6px;text-align:center;background:var(--panel-2);border:1px dashed var(--ok);border-radius:16px;padding:22px}
.codebox .code{font-size:42px;font-weight:800;letter-spacing:12px;color:var(--ok-hot);font-family:ui-monospace,Menlo,Consolas,monospace;text-shadow:0 0 24px rgba(52,211,153,.45)}
.codebox p{color:var(--text-2);font-size:12px;line-height:1.75;margin:14px 0 0}

.foot{display:flex;justify-content:center;gap:14px;color:#54687c;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;padding:0 20px 26px;flex-wrap:wrap}
@media (max-width:560px){.top{padding:14px 16px}.card{padding:20px}.qrbox{width:262px;height:262px}.qrbox img{width:244px;height:244px}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="backdrop" aria-hidden="true"></div>

<header class="top">
  <span class="logo">R</span>
  <span><b>Raqifluz Signal Desk</b><small>Link a number</small></span>
  <span class="ver">v12.0 · Obsidian</span>
  <a class="back" href="/admin">Dashboard →</a>
</header>

<main class="wrap">
  <section class="card" aria-labelledby="linkTitle">
    <div class="kicker">WhatsApp Linked Device</div>
    <h1 id="linkTitle">Link a WhatsApp number</h1>
    <p class="sub">Either scan the QR with the phone, or type an 8-character pairing code — both do the same thing. The code works for about a minute.</p>

    <div class="tabs" role="tablist">
      <div class="tab active" id="tabQr" role="tab" tabindex="0" aria-selected="true">📷 Scan QR code</div>
      <div class="tab" id="tabPair" role="tab" tabindex="0" aria-selected="false">🔢 Pairing code</div>
    </div>

    <!-- QR pane -->
    <div id="paneQr" role="tabpanel">
      <ol>
        <li>Open <b>WhatsApp</b> on the phone</li>
        <li>Tap <b>Settings → Linked devices → Link a device</b></li>
        <li>Point the phone at this code</li>
      </ol>
      <button class="btn" id="genBtn">＋ Generate QR code</button>
      <div class="qrbox" id="qrbox" style="display:none"><span class="ph">QR will appear here</span></div>
      <div class="hint" id="qrHint" style="display:none">QR refreshes by itself — finish on the phone within a minute.</div>
    </div>

    <!-- pairing-code pane -->
    <div id="panePair" role="tabpanel" hidden>
      <ol>
        <li>Enter the phone number with country code</li>
        <li>Press <b>Get pairing code</b></li>
        <li>On the phone: <b>WhatsApp → Settings → Linked devices → Link with phone number</b></li>
        <li>Type the 8-character code shown below</li>
      </ol>
      <input type="text" id="pairPhone" inputmode="numeric" autocomplete="off" placeholder="Phone with country code, e.g. 923001234567" aria-label="Phone number with country code">
      <button class="btn" id="pairBtn">Get pairing code</button>
      <div class="codebox" id="pairBox" style="display:none">
        <div class="code" id="pairCode">········</div>
        <p>Type this code on the phone:<br><b>WhatsApp → Settings → Linked devices → Link with phone number</b><br>The code works for about a minute.</p>
        <div style="margin-top:14px"><button class="btn ghost" id="pairNew" type="button">↻ Get a new code</button></div>
      </div>
      <div class="hint" id="pairHint" style="display:none">Waiting for the phone… the code above stays valid about a minute.</div>
    </div>

    <div class="ok" id="okMsg" style="display:none" role="status"></div>
    <div class="err" id="errMsg" role="alert"></div>
  </section>
</main>

<footer class="foot"><span>End-to-end encrypted session</span><span>·</span><span>Credentials never leave your server</span><span>·</span><span>v12.0.0</span></footer>

<script>
var $ = function (s) { return document.querySelector(s); };
var poll = null, curId = null, mode = 'qr';

function showTab(m) {
  mode = m;
  $('#tabQr').classList.toggle('active', m === 'qr');
  $('#tabPair').classList.toggle('active', m === 'pair');
  $('#tabQr').setAttribute('aria-selected', String(m === 'qr'));
  $('#tabPair').setAttribute('aria-selected', String(m === 'pair'));
  $('#paneQr').hidden = m !== 'qr';
  $('#panePair').hidden = m !== 'pair';
}
$('#tabQr').addEventListener('click', function () { showTab('qr'); });
$('#tabPair').addEventListener('click', function () { showTab('pair'); });
$('#tabQr').addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showTab('qr'); } });
$('#tabPair').addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showTab('pair'); } });

function stopPoll() { if (poll) { clearInterval(poll); poll = null; } }
function ok(msg) { stopPoll(); $('#okMsg').style.display = 'block'; $('#okMsg').innerHTML = msg; }
function fail(msg) { $('#errMsg').style.display = 'block'; $('#errMsg').textContent = msg; }

function pollOnce() {
  if (!curId) return;
  fetch('/api/public/connect/' + curId).then(function (r) { return r.json(); }).then(function (d) {
    if (mode === 'qr') {
      if (d.status === 'qr' && d.qr) {
        $('#qrbox').style.display = 'grid';
        $('#qrbox').innerHTML = '<img alt="WhatsApp QR" src="' + d.qr + '">';
        $('#qrHint').style.display = 'block';
      } else if (d.status === 'open') {
        ok('✅ <b>+' + (d.phone || '') + ' connected.</b> Its chats, contacts and history are syncing into the dashboard now.');
      } else if (d.status === 'logged_out') {
        fail('The phone removed this device. Press the button again to make a new QR.');
      }
    } else {
      if (d.pairCode) {
        $('#pairBox').style.display = 'block';
        $('#pairHint').style.display = 'block';
        if (d.pairCode !== $('#pairCode').textContent) $('#pairCode').textContent = d.pairCode;
      }
      if (d.status === 'open') {
        ok('✅ <b>+' + (d.phone || '') + ' connected.</b> Its chats, contacts and history are syncing into the dashboard now.');
      } else if (d.status === 'logged_out') {
        fail('The phone removed this device. Get a new code and try again.');
      } else if (d.status === 'close' && !d.pairCode) {
        fail('The pairing session dropped — press “Get pairing code” again.');
      }
    }
  }).catch(function () {});
}
function startPoll() { stopPoll(); poll = setInterval(pollOnce, 2500); pollOnce(); }

$('#genBtn').addEventListener('click', function () {
  var btn = this; btn.disabled = true;
  $('#errMsg').style.display = 'none'; $('#okMsg').style.display = 'none';
  $('#qrbox').style.display = 'grid';
  $('#qrbox').innerHTML = '<span class="spin">Starting the pairing…<br>the QR appears in a few seconds</span>';
  fetch('/api/public/connect', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ label: 'extra number' }) })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || 'Could not start pairing.');
      curId = d.id; startPoll();
      setTimeout(function () { btn.disabled = false; btn.textContent = '＋ Connect another number'; }, 9000);
    })
    .catch(function (e) {
      $('#qrbox').style.display = 'none';
      fail(e.message); btn.disabled = false;
    });
});

function requestPairCode(replaceId) {
  var phone = $('#pairPhone').value.trim();
  var btn = $('#pairBtn');
  btn.disabled = true; btn.textContent = 'Asking WhatsApp for a code…';
  $('#errMsg').style.display = 'none'; $('#okMsg').style.display = 'none';
  $('#pairBox').style.display = 'none'; $('#pairHint').style.display = 'none';
  var body = { phone: phone };
  if (replaceId) body.replace = replaceId;
  fetch('/api/public/pair', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.ok) throw new Error(d.error || 'Could not create the pairing code.');
      curId = d.id;
      $('#pairCode').textContent = d.code;
      $('#pairBox').style.display = 'block';
      $('#pairHint').style.display = 'block';
      $('#pairNew').style.display = '';
      startPoll();
      btn.disabled = false; btn.textContent = 'Get pairing code';
    })
    .catch(function (e) {
      fail(e.message);
      btn.disabled = false; btn.textContent = 'Get pairing code';
    });
}
$('#pairBtn').addEventListener('click', function () { requestPairCode(''); });
$('#pairNew').addEventListener('click', function () { requestPairCode(curId || ''); });
</script>
</body>
</html>
